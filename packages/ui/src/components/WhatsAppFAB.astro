---
import { WA_NUMBER } from "../constants";
import { wa } from "../wa";
const href = wa(WA_NUMBER, "Halo, saya ingin konsultasi tentang layanan yang tersedia");
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 w-16 h-16 rounded-full bg-linear-to-br from-green-500 to-green-600 text-white flex items-center justify-center shadow-2xl z-40 hover:scale-110 transition-all duration-300 group"
    aria-label="Konsultasi WhatsApp"
>
    <i class="fab fa-whatsapp text-2xl"></i>

    <div
        class="absolute -top-12 right-0 bg-gray-900 text-white px-3 py-2 rounded-lg text-sm whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity"
    >
        Konsultasi Gratis
    </div>
</a>
