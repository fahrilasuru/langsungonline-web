# Salin ke .env untuk pengembangan lokal. Jangan commit .env.

# Dibaca server Astro saat runtime untuk memanggil API (halaman /preview/<id>).
# Bila kosong saat `astro dev`, otomatis http://localhost:8000. Di produksi WAJIB diisi.
API_URL=http://localhost:8000

# Dibaca BROWSER (formulir cerita). Ditanam saat build: ubah nilainya = deploy ulang.
PUBLIC_API_URL=http://localhost:8000

# Opsional. Basis URL antar-app (lihat apps/marketing/.env.example).
# PUBLIC_MARKETING_URL=http://localhost:4321
# PUBLIC_COBA_URL=http://localhost:4322

# Opsional. Nomor WhatsApp tim, format internasional tanpa +.
# PUBLIC_WA_NUMBER=62881036209010
