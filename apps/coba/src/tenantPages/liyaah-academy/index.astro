<h1>Dalam Perbaikan</h1>
<button id="btn">Click me!</button>

<script>
    document.getElementById("btn").addEventListener("click", async () => {
        try {
            const response = await fetch("/liyaah-academy/api/v1/health");
            const data = await response.json();
            alert(data.message);
        } catch (error) {
            alert("Error");
        }
    });
</script>