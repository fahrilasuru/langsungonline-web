---
import { labelOf } from "../../presence";
const { channels } = Astro.props;
---
<nav class="pnav" id="pnav" aria-label="Kanal digital"><div class="wrap">
  {channels.map((c) => <a class="pill" href={`#${c.type}`} data-t={c.type}>{labelOf(c)}</a>)}
</div></nav>
<script>
  const nav = document.getElementById("pnav")!, web = document.getElementById("website")!;
  const upd = () => nav.classList.toggle("on", web.getBoundingClientRect().bottom < 140);
  addEventListener("scroll", upd, { passive: true }); upd();
  // Hanya menggeser bar pill ke samping; halaman tidak disentuh.
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    document.querySelectorAll<HTMLElement>(".pill").forEach((p) => {
      const on = p.dataset.t === e.target.id;
      p.classList.toggle("act", on);
      if (on) { const bar = p.parentElement!; bar.scrollTo({ left: p.offsetLeft - (bar.clientWidth - p.offsetWidth) / 2 }); }
    });
  }), { rootMargin: "-30% 0px -60% 0px" });
  document.querySelectorAll("[data-presence]").forEach((s) => io.observe(s));
</script>
