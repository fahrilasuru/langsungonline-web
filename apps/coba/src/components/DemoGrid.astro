---
import { WA_NUMBER } from "@langsungonline/ui/constants";
import { wa } from "@langsungonline/ui/wa";
import { demoGroups, demos } from "../pages/demo/_demos";

const groups = demoGroups
    .map((g) => ({ ...g, items: demos.filter((d) => d.kind === g.kind) }))
    .filter((g) => g.items.length > 0);
const ctalink = wa(WA_NUMBER, "Halo, saya tertarik dan ingin konsultasi");
---

<section class="demo-section">
    <div class="container">
        {
            groups.map((group) => (
                <div class="demo-group" id={group.kind}>
                    <div class="group-header" data-aos="fade-up">
                        <h2>{group.title}</h2>
                        <p>{group.subtitle}</p>
                    </div>

                    <div class="demo-grid">
                        {group.items.map((demo) => (
                            <div class="demo-card" data-aos="fade-up">
                                <div
                                    class="card-icon"
                                    style={`background-color: ${demo.iconBg}; color: ${demo.iconColor};`}
                                >
                                    <i class={`fas fa-${demo.icon}`} />
                                </div>

                                <h3>{demo.title}</h3>
                                <p class="card-desc">{demo.description}</p>

                                <div class="card-tags">
                                    {demo.tags.map((tag) => (
                                        <span class="tag">{tag}</span>
                                    ))}
                                </div>

                                <div class="card-features">
                                    {demo.features.map((feature) => (
                                        <div class="feature-item">
                                            <i class="fas fa-check-circle" />
                                            <span>{feature}</span>
                                        </div>
                                    ))}
                                </div>

                                <a href={demo.url} class="card-btn">
                                    <i class="fas fa-eye" />
                                    Lihat Contoh
                                </a>
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }

        <div class="cta-wrapper">
            <div class="cta-inline">
                <span class="cta-question">Belum menemukan yang pas?</span>
                <a
                    href={ctalink}
                    class="cta-wa-button"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <i class="fab fa-whatsapp"></i>
                    Diskusikan Bisnis Anda
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .demo-section {
        padding: 4rem 0 5rem;
        background: white;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .demo-group + .demo-group {
        margin-top: 4rem;
    }

    .group-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .group-header h2 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 0.5rem;
    }

    @media (min-width: 768px) {
        .group-header h2 {
            font-size: 2.25rem;
        }
    }

    .group-header p {
        color: #6b7280;
        font-size: 1.05rem;
    }

    /* 1 kolom di ponsel, 2 di tablet, 4 di desktop (sama seperti sebelumnya) */
    .demo-grid {
        display: grid;
        gap: 1.5rem;
        justify-content: center;
        margin-bottom: 2rem;
        grid-template-columns: 1fr;
    }

    @media (min-width: 641px) {
        .demo-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .demo-grid {
            grid-template-columns: repeat(4, minmax(0, 280px));
        }
    }

    .demo-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid #f3f4f6;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
        margin: 0 auto;
    }

    .demo-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        border-color: #dcfce7;
    }

    .card-icon {
        width: 3rem;
        height: 3rem;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }

    .demo-card h3 {
        font-size: 1.125rem;
        font-weight: 600;
        color: #111827;
        margin-bottom: 0.25rem;
        text-align: left;
    }

    .card-desc {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 0.75rem;
        line-height: 1.4;
        text-align: left;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-bottom: 1rem;
        justify-content: flex-start;
    }

    .tag {
        background: #f3f4f6;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        font-size: 0.7rem;
        font-weight: 500;
        color: #4b5563;
    }

    .card-features {
        margin: 0 0 1.25rem;
        flex-grow: 1;
        text-align: left;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.4rem;
        font-size: 0.875rem;
        color: #4b5563;
        text-align: left;
    }

    .feature-item i {
        color: #16a34a;
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    .card-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: white;
        border: 1px solid #e5e7eb;
        padding: 0.6rem 1rem;
        border-radius: 0.75rem;
        font-weight: 500;
        font-size: 0.875rem;
        color: #374151;
        text-decoration: none;
        transition: all 0.2s;
        margin-top: auto;
    }

    .card-btn i {
        color: #16a34a;
        font-size: 0.9rem;
    }

    .card-btn:hover {
        background: #f9fafb;
        border-color: #16a34a;
        color: #16a34a;
    }

    .cta-wrapper {
        margin-top: 2.5rem;
    }

    .cta-inline {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 1rem 0;
    }

    .cta-question {
        font-size: 1.35rem;
        font-weight: 500;
        color: #374151;
    }

    .cta-wa-button {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 2rem;
        background: #16a34a;
        color: white;
        font-weight: 600;
        border-radius: 9999px;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 1.1rem;
        box-shadow: 0 4px 10px -2px rgba(22, 163, 74, 0.3);
    }

    .cta-wa-button:hover {
        background: #15803d;
        transform: scale(1.05);
        box-shadow: 0 6px 15px -3px rgba(22, 163, 74, 0.4);
    }

    .cta-wa-button i {
        font-size: 1.25rem;
    }

    @media (max-width: 640px) {
        .cta-inline {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .cta-question {
            font-size: 1.25rem;
        }
        
        .cta-wa-button {
            width: 100%;
            justify-content: center;
            padding: 0.875rem 1.5rem;
        }
    }
</style>