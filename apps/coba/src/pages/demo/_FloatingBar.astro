---
export interface Props {
    title: string;
}

import { WA_NUMBER } from "@langsungonline/ui/constants";
import { wa } from "@langsungonline/ui/wa";

const { title } = Astro.props;
const href = wa(WA_NUMBER, `Halo saya tertarik dengan Demo ${title}`);
---

<div class="floating-bar">
    <div class="floating-bar-content">
        <span class="demo-title">
            <i class="fas fa-eye"></i>
            Demo {title}
        </span>
        
        <a
            href={href}
            class="btn-wa"
            target="_blank"
            rel="noopener noreferrer"
        >
            <i class="fab fa-whatsapp"></i>
            <span>Pesan Sekarang</span>
        </a>
    </div>
</div>

<style>
    .floating-bar {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        width: 90%;
        max-width: 600px;
        background: rgba(0, 0, 0, 0.5); /* Transparansi 0.5 sesuai permintaan */
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-radius: 60px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        padding: 12px 20px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-family:
            system-ui,
            -apple-system,
            sans-serif;
    }

    .floating-bar-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .demo-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.95rem;
        font-weight: 600; /* Lebih tebal */
        color: white;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5); /* Shadow lebih kuat */
        letter-spacing: 0.3px; /* Sedikit renggang biar lebih terbaca */
    }

    .demo-title i {
        color: #ffd700;
        font-size: 1rem;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
    }

    .btn-wa {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        background: #25d366;
        color: white;
        border-radius: 40px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.3);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .btn-wa:hover {
        background: #20bd5a;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    }

    @media (max-width: 480px) {
        .floating-bar {
            padding: 10px 16px;
            background: rgba(0, 0, 0, 0.6); /* Tetap 0.6 di mobile biar lebih terbaca */
            backdrop-filter: blur(4px);
        }

        .demo-title {
            font-size: 0.9rem;
            font-weight: 600;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
        }

        .demo-title i {
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6));
        }

        .btn-wa span {
            display: none;
        }

        .btn-wa {
            padding: 8px 12px;
        }

        .btn-wa i {
            font-size: 1.2rem;
            margin: 0;
        }
    }

    /* Untuk layar sangat kecil */
    @media (max-width: 360px) {
        .demo-title {
            max-width: 150px;
        }
    }

    @keyframes slideUp {
        from {
            transform: translate(-50%, 100%);
            opacity: 0;
        }
        to {
            transform: translate(-50%, 0);
            opacity: 1;
        }
    }

    .floating-bar {
        animation: slideUp 0.5s ease forwards;
    }
</style>