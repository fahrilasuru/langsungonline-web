---
import DemoWrapper from "./_DemoWrapper.astro";
---

<DemoWrapper title="Brosur" description="Demo suatu laman brosur">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="body">
    <div class="brosur">
      <!-- KEPALA -->
      <div class="atas">
        <div class="judul-akbar">ARSITEKTUR<br />2026</div>
        <div class="label-hari">
          <i class="fas fa-calendar-alt"></i>
          <span>17 FEB 2026</span>
        </div>
      </div>

      <!-- GRID PEMBICARA + CUPLIKAN -->
      <div class="grid-dua">
        <div class="blok-pembicara">
          <h2>
            <i class="fas fa-users"></i>
            <span>PEMBICARA</span>
          </h2>
          <div class="pembicara-item">
            <i class="fas fa-user-tie"></i>
            <div class="pembicara-info">
              <span class="nama">Prof. Siti Nuraini</span>
              <span class="ket">UI · arsitektur</span>
            </div>
          </div>
          <div class="pembicara-item">
            <i class="fas fa-chart-line"></i>
            <div class="pembicara-info">
              <span class="nama">Dr. Andi Saputra</span>
              <span class="ket">kebijakan publik</span>
            </div>
          </div>
          <div class="pembicara-item">
            <i class="fas fa-draw-polygon"></i>
            <div class="pembicara-info">
              <span class="nama">Ratna Dewi, M.Ars</span>
              <span class="ket">tata kota</span>
            </div>
          </div>
          <div class="pembicara-item">
            <i class="fas fa-city"></i>
            <div class="pembicara-info">
              <span class="nama">Irwan Kurniawan</span>
              <span class="ket">pengembang</span>
            </div>
          </div>
        </div>

        <div class="cuplikan">
          <div class="cuplikan-header">
            <i class="fas fa-bullhorn"></i>
          </div>
          <p>
            Seminar nasional tahunan tentang masa depan arsitektur dan
            perkotaan. Diskusi panel, workshop, dan pameran.
          </p>
          <div class="cuplikan-badge">
            <span class="badge">
              <i class="fas fa-clock"></i>
              09.00–16.30
            </span>
            <span class="badge">
              <i class="fas fa-tag"></i>
              250 kursi
            </span>
          </div>
        </div>
      </div>

      <!-- INFORMASI LENGKAP -->
      <div class="info-lengkap">
        <div class="judul-info">
          <i class="fas fa-circle-info"></i>
          <span>INFORMASI LENGKAP</span>
        </div>

        <div class="grid-info">
          <div class="card-info">
            <h3>
              <i class="fas fa-map-pin"></i>
              WAKTU & TEMPAT
            </h3>
            <div class="detail-info">
              <i class="fas fa-calendar-check"></i>
              <div><strong>Hari</strong> Selasa, 17 Feb 2026</div>
            </div>
            <div class="detail-info">
              <i class="fas fa-clock"></i>
              <div><strong>Pukul</strong> 09.00 – 16.30 WIB</div>
            </div>
            <div class="detail-info">
              <i class="fas fa-location-dot"></i>
              <div>
                <strong>Lokasi</strong> Auditorium Graha Puthur Lt.4<br />
                Jl. Pecinan VI No.10, Jakpus
              </div>
            </div>
            <div class="detail-info">
              <i class="fas fa-train-subway"></i>
              <div><strong>Akses</strong> Stasiun Gondangdia / TransJ 2</div>
            </div>
            <div class="detail-info">
              <i class="fas fa-car"></i>
              <div><strong>Parkir</strong> basement (100 motor, 50 mobil)</div>
            </div>
          </div>

          <div class="card-info">
            <h3>
              <i class="fas fa-address-card"></i>
              KONTAK & BIAYA
            </h3>
            <div class="detail-info">
              <i class="fab fa-whatsapp"></i>
              <div><strong>WA</strong> 0812-3456-7890 (Rini)</div>
            </div>
            <div class="detail-info">
              <i class="fab fa-instagram"></i>
              <div><strong>IG</strong> @seminararsitektural</div>
            </div>
            <div class="detail-info">
              <i class="fas fa-money-bill"></i>
              <div><strong>Biaya</strong> Rp150.000 / Rp75.000 (mhs)</div>
            </div>
            <div class="info-benefit">
              <i class="fas fa-utensils"></i>
              snack, makan siang, modul
            </div>
          </div>
        </div>
      </div>

      <!-- JADWAL ACARA -->
      <div class="jadwal-container">
        <div class="judul-jadwal">
          <i class="fas fa-list"></i>
          JADWAL ACARA
        </div>
        <div class="jadwal-list">
          <div class="baris-jadwal">
            <i class="fas fa-pen-to-square"></i>
            <span class="waktu">09.00–09.30</span>
            <span class="acara">Registrasi peserta</span>
          </div>
          <div class="baris-jadwal">
            <i class="fas fa-file"></i>
            <span class="waktu">09.30–10.30</span>
            <span class="acara">Keynote: Prof. Siti Nuraini</span>
          </div>
          <div class="baris-jadwal">
            <i class="fas fa-chalkboard-user"></i>
            <span class="waktu">10.30–12.00</span>
            <span class="acara">Sesi 1 – Kebijakan kota (Dr. Andi Saputra)</span
            >
          </div>
          <div class="baris-jadwal">
            <i class="fas fa-utensils"></i>
            <span class="waktu">12.00–13.00</span>
            <span class="acara">Ishoma & makan siang</span>
          </div>
          <div class="baris-jadwal">
            <i class="fas fa-people-arrows"></i>
            <span class="waktu">13.00–14.30</span>
            <span class="acara">Sesi 2 – Tata kota (Ratna Dewi)</span>
          </div>
          <div class="baris-jadwal">
            <i class="fas fa-comments"></i>
            <span class="waktu">14.30–15.30</span>
            <span class="acara">Panel diskusi + tanya jawab</span>
          </div>
          <div class="baris-jadwal">
            <i class="fas fa-certificate"></i>
            <span class="waktu">15.30–16.30</span>
            <span class="acara">Penutupan & sertifikat</span>
          </div>
        </div>
      </div>

      <!-- CALL TO ACTION -->
      <div class="cta-raya">
        <div class="cta-kiri">
          <i class="fas fa-arrow-right"></i>
          <span class="cta-teks">DAFTAR</span>
        </div>
        <span class="tombol-cta">
          <i class="fas fa-pencil-alt"></i>
          DAFTAR
        </span>
        <span class="kuota-badge">
          <i class="fas fa-users"></i>
          kuota 250
        </span>
      </div>

      <!-- QR SCAN -->
      <div class="qr-blok">
        <div class="qr-palsu"></div>
        <div class="info-kontak">
          <i class="fas fa-qrcode"></i>
          SCAN UNTUK DAFTAR
        </div>
        <div class="sosmed-icons">
          <span><i class="fab fa-whatsapp"></i></span>
          <span><i class="fab fa-instagram"></i></span>
          <span><i class="fab fa-tiktok"></i></span>
        </div>
      </div>

      <!-- FOOTER -->
      <div class="footer-brutal">
        <span class="footer-item">
          <i class="fas fa-building"></i>
          IAI DKI
        </span>
        <span class="footer-item">
          <i class="fas fa-helmet-safety"></i>
          Kementerian PUPR
        </span>
        <span class="footer-item">
          <i class="fas fa-hashtag"></i>
          seminararsitek2026
        </span>
      </div>
    </div>
  </div>
</DemoWrapper>

<style>
  .body {
    --hitam: #000;
    --putih: #fff;
    --kuning: #ffcc00;
    --pink: #ff0066;
    --pink-terang: #ff66cc;
    --abu-abu: #1a1a1a;
    --shadow-keras: 4px 4px 0 var(--hitam);
    --ukuran-ikon: 1rem;
    --ukuran-ikon-sedang: 1.2rem;
    --ukuran-ikon-badge: 0.9rem;

    font-family: "Space Grotesk", sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: clamp(10px, 3vw, 30px);
    color: var(--hitam);
  }

  /* === BROSUR UTAMA === */
  .brosur {
    max-width: 1400px;
    width: 100%;
    background: var(--putih);
    border: clamp(4px, 0.6vw, 8px) solid var(--hitam);
    box-shadow:
      clamp(8px, 1.5vw, 20px) clamp(8px, 1.5vw, 20px) 0 var(--hitam),
      clamp(8px, 1.5vw, 20px) clamp(8px, 1.5vw, 20px) 0 clamp(4px, 0.5vw, 8px)
        var(--kuning);
    padding: clamp(1.2rem, 3.5vw, 3rem);
    position: relative;
  }

  .brosur::before {
    content: "";
    position: absolute;
    top: clamp(8px, 1.5vw, 20px);
    right: clamp(-3px, -0.8vw, -8px);
    width: clamp(50px, 7vw, 50px);
    height: clamp(50px, 7vw, 50px);
    background: repeating-linear-gradient(
      45deg,
      var(--pink) 0px,
      var(--pink) 8px,
      var(--putih) 8px,
      var(--putih) 16px
    );
    border: clamp(2px, 0.3vw, 4px) solid var(--hitam);
    z-index: 10;
    pointer-events: none;
  }

  /* === KEPALA === */
  .atas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-bottom: clamp(4px, 0.6vw, 8px) solid var(--hitam);
    padding-bottom: clamp(0.8rem, 1.8vw, 1.5rem);
    margin-bottom: clamp(1.2rem, 2.5vw, 2.5rem);
    background: linear-gradient(45deg, var(--putih) 60%, #ffffc0);
  }

  .judul-akbar {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 0.9;
    text-transform: uppercase;
    background: var(--hitam);
    color: var(--putih);
    padding: clamp(0.2rem, 0.8vw, 0.4rem) clamp(0.8rem, 2.5vw, 2rem);
    border: clamp(2px, 0.4vw, 5px) solid var(--pink);
    outline: clamp(2px, 0.4vw, 5px) solid var(--hitam);
    transform: rotate(-0.5deg);
    box-shadow: clamp(6px, 1.2vw, 12px) clamp(6px, 1.2vw, 12px) 0 var(--kuning);
  }

  .label-hari {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1rem, 3vw, 1.8rem);
    font-weight: 700;
    border: clamp(2px, 0.4vw, 5px) solid var(--hitam);
    padding: clamp(0.2rem, 0.8vw, 0.6rem) clamp(0.8rem, 2.5vw, 2rem);
    background: var(--kuning);
    box-shadow: clamp(6px, 1.2vw, 14px) clamp(6px, 1.2vw, 14px) 0 var(--hitam);
    transform: rotate(0.5deg);
    white-space: nowrap;
  }

  .label-hari i {
    font-size: clamp(0.9rem, 2.5vw, 1.4rem);
  }

  /* === GRID UTAMA === */
  .grid-dua {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    margin-bottom: clamp(1.5rem, 3vw, 3rem);
  }

  /* blok pembicara */
  .blok-pembicara {
    border: clamp(3px, 0.4vw, 5px) solid var(--hitam);
    padding: clamp(1rem, 2.5vw, 2rem);
    background: linear-gradient(135deg, var(--putih), #f9f9f9);
    box-shadow: clamp(6px, 1.2vw, 14px) clamp(6px, 1.2vw, 14px) 0 var(--hitam);
  }

  .blok-pembicara h2 {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 700;
    background: var(--hitam);
    color: var(--putih);
    padding: clamp(0.2rem, 0.8vw, 0.4rem) clamp(0.8rem, 2.5vw, 2rem);
    border: clamp(2px, 0.3vw, 4px) solid var(--kuning);
    outline: clamp(2px, 0.3vw, 4px) solid var(--hitam);
    margin-bottom: clamp(1.2rem, 2.5vw, 2rem);
    transform: rotate(-0.3deg);
  }

  .blok-pembicara h2 i {
    font-size: clamp(0.9rem, 2.5vw, 1.4rem);
  }

  .pembicara-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border: 2px solid var(--hitam);
    padding: 0.75rem;
    margin-bottom: 0.8rem;
    background: #c0ffc0;
    box-shadow: var(--shadow-keras);
  }

  .pembicara-item i {
    font-size: 1rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--putih);
    border: 2px solid var(--hitam);
    flex-shrink: 0;
  }

  .pembicara-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    flex: 1;
  }

  .pembicara-item .nama {
    font-size: clamp(0.9rem, 2.2vw, 1.4rem);
    font-weight: 700;
  }

  .pembicara-item .ket {
    font-size: clamp(0.7rem, 1.8vw, 1rem);
    border-left: 2px solid var(--hitam);
    padding-left: 0.5rem;
    background: var(--putih);
    padding: 0.2rem 0.5rem;
  }

  /* cuplikan */
  .cuplikan {
    border: clamp(3px, 0.4vw, 5px) solid var(--hitam);
    padding: clamp(1rem, 2.5vw, 2rem);
    background: linear-gradient(145deg, #fff3e0, #ffe0b0);
    box-shadow: clamp(6px, 1.2vw, 14px) clamp(6px, 1.2vw, 14px) 0 var(--hitam);
  }

  .cuplikan-header {
    margin-bottom: 1rem;
  }

  .cuplikan-header i {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    border: 3px solid var(--hitam);
    padding: 0.5rem;
    background: var(--pink-terang);
    box-shadow: var(--shadow-keras);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .cuplikan p {
    font-size: clamp(0.9rem, 2.2vw, 1.4rem);
    margin: 1rem 0;
    border-left: clamp(4px, 0.6vw, 10px) solid var(--pink);
    padding-left: 1rem;
    line-height: 1.5;
  }

  .cuplikan-badge {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.8rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 2px solid var(--hitam);
    padding: 0.4rem 0.8rem;
    background: var(--putih);
    font-weight: 700;
    font-size: clamp(0.7rem, 1.8vw, 1rem);
    box-shadow: var(--shadow-keras);
  }

  .badge i {
    font-size: 0.8rem;
  }

  /* === INFORMASI LENGKAP === */
  .info-lengkap {
    border: clamp(4px, 0.5vw, 6px) solid var(--hitam);
    padding: clamp(1.2rem, 2.5vw, 2.2rem);
    background: #ffefc0;
    box-shadow: clamp(8px, 1.5vw, 18px) clamp(8px, 1.5vw, 18px) 0 var(--hitam);
    margin: clamp(1.5rem, 3vw, 3rem) 0;
  }

  .judul-info {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.2rem, 3.5vw, 2rem);
    font-weight: 700;
    background: var(--hitam);
    color: var(--putih);
    padding: clamp(0.2rem, 0.8vw, 0.4rem) clamp(1rem, 3vw, 2.2rem);
    border: clamp(2px, 0.4vw, 5px) solid var(--pink);
    outline: clamp(2px, 0.4vw, 5px) solid var(--hitam);
    margin-bottom: clamp(1.2rem, 2.5vw, 2rem);
    transform: rotate(-0.5deg);
  }

  .judul-info i {
    font-size: clamp(0.9rem, 2.5vw, 1.4rem);
  }

  .grid-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  .card-info {
    border: clamp(3px, 0.4vw, 5px) solid var(--hitam);
    background: linear-gradient(45deg, var(--putih), #f0f0ff);
    padding: clamp(1rem, 2.2vw, 1.8rem);
    box-shadow: clamp(6px, 1.2vw, 12px) clamp(6px, 1.2vw, 12px) 0 var(--hitam);
  }

  .card-info h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    border-bottom: 3px solid var(--hitam);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    background: #ffb86b;
    padding: 0.5rem;
  }

  .card-info h3 i {
    font-size: clamp(0.8rem, 2.2vw, 1.2rem);
  }

  .detail-info {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px dashed var(--hitam);
    padding: 0.7rem 0;
    font-size: clamp(0.8rem, 2vw, 1rem);
  }

  .detail-info i {
    font-size: 0.9rem;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--hitam);
    color: var(--putih);
    border: 2px solid var(--putih);
    outline: 2px solid var(--hitam);
    flex-shrink: 0;
  }

  .detail-info strong {
    background: var(--kuning);
    padding: 0.2rem 0.6rem;
    border: 2px solid var(--hitam);
    font-size: 0.8rem;
    margin-right: 0.3rem;
  }

  .info-benefit {
    border: 3px solid var(--hitam);
    margin-top: 1rem;
    padding: 0.8rem;
    background: #ffb347;
    text-align: center;
    font-weight: 700;
    box-shadow: var(--shadow-keras);
    font-size: clamp(0.8rem, 2vw, 1rem);
  }

  .info-benefit i {
    font-size: 0.8rem;
    margin-right: 0.3rem;
  }

  /* === JADWAL === */
  .jadwal-container {
    border: clamp(4px, 0.5vw, 6px) solid var(--hitam);
    padding: clamp(1.2rem, 2.5vw, 2.2rem);
    background: linear-gradient(135deg, var(--putih), #e0ffe0);
    box-shadow: clamp(8px, 1.5vw, 16px) clamp(8px, 1.5vw, 16px) 0 var(--hitam);
    margin: clamp(1.5rem, 3vw, 3rem) 0;
  }

  .judul-jadwal {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.2rem, 3.5vw, 2rem);
    font-weight: 700;
    border-bottom: 3px solid var(--hitam);
    margin-bottom: 1rem;
    background: var(--hitam);
    color: var(--putih);
    padding: 0.3rem 1.5rem;
    transform: rotate(0.3deg);
  }

  .judul-jadwal i {
    font-size: clamp(0.9rem, 2.5vw, 1.4rem);
  }

  .jadwal-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .baris-jadwal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 2px solid var(--hitam);
    padding: 0.5rem 0;
  }

  .baris-jadwal i {
    font-size: 0.9rem;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--pink);
    color: var(--putih);
    border: 2px solid var(--hitam);
    box-shadow: 2px 2px 0 var(--hitam);
    flex-shrink: 0;
  }

  .waktu {
    background: var(--hitam);
    color: var(--putih);
    font-weight: 700;
    padding: 0.2rem 0.8rem;
    border: 2px solid var(--kuning);
    outline: 2px solid var(--hitam);
    min-width: clamp(100px, 15vw, 130px);
    text-align: center;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .acara {
    font-size: clamp(0.8rem, 2vw, 1rem);
    flex: 1;
  }

  /* === CTA === */
  .cta-raya {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    background: linear-gradient(145deg, var(--pink-terang), #ff99ff);
    border: clamp(4px, 0.5vw, 6px) solid var(--hitam);
    padding: clamp(1rem, 2.5vw, 2rem) clamp(1.2rem, 3vw, 3rem);
    box-shadow: clamp(10px, 2vw, 20px) clamp(10px, 2vw, 20px) 0 var(--hitam);
    margin: clamp(1.5rem, 3vw, 3rem) 0;
  }

  .cta-kiri {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-kiri i {
    font-size: clamp(1.2rem, 4vw, 2.2rem);
    background: var(--putih);
    border: 3px solid var(--hitam);
    padding: 0.3rem;
    box-shadow: var(--shadow-keras);
  }

  .cta-teks {
    font-size: clamp(1.2rem, 4vw, 2.2rem);
    font-weight: 700;
    text-transform: uppercase;
    background: var(--putih);
    border: 3px solid var(--hitam);
    padding: 0.2rem 1rem;
    box-shadow: var(--shadow-keras);
    transform: rotate(-0.5deg);
  }

  .tombol-cta {
