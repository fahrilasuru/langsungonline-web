<!-- ===== TOPBAR ===== -->
<header class="topbar">
    <button class="btn-icon menu-btn" data-action="open-sidebar" aria-label="Buka menu">
        <span class="material-icons">menu</span>
    </button>

    <div class="page-title">
        <h1 id="pageTitle">Dashboard</h1>
        <p id="pageSub"></p>
    </div>

    <div class="search dropdown" id="searchBox">
        <span class="material-icons search-icon">search</span>
        <input
            type="search"
            id="globalSearch"
            class="search-input"
            placeholder="Cari produk, pesanan, pengguna…"
            autocomplete="off"
            aria-label="Pencarian"
        />
        <kbd class="search-kbd">/</kbd>
        <div class="menu search-results" id="searchResults" role="listbox"></div>
    </div>

    <div class="topbar-actions">
        <div class="dropdown" id="createMenu">
            <button class="btn btn-primary create-btn" data-dropdown-toggle aria-expanded="false" aria-haspopup="menu">
                <span class="material-icons">add</span><span class="create-label">Buat baru</span>
            </button>
            <div class="menu menu-right" role="menu">
                <button class="menu-item" role="menuitem" data-action="new-order">
                    <span class="material-icons">receipt_long</span>Pesanan baru
                </button>
                <button class="menu-item" role="menuitem" data-action="new-product">
                    <span class="material-icons">add_box</span>Produk baru
                </button>
                <button class="menu-item" role="menuitem" data-action="new-user">
                    <span class="material-icons">person_add</span>Pengguna baru
                </button>
            </div>
        </div>

        <div class="dropdown" id="notifMenu">
            <button class="btn-icon bell" data-dropdown-toggle aria-label="Notifikasi" aria-expanded="false" aria-haspopup="true">
                <span class="material-icons">notifications</span>
                <span class="bell-dot" id="bellDot" hidden></span>
            </button>
            <div class="menu menu-right notif-menu">
                <div class="menu-head">
                    <strong>Notifikasi</strong>
                    <button class="link-btn" data-action="read-all">Tandai semua dibaca</button>
                </div>
                <div id="notifList"></div>
            </div>
        </div>

        <div class="dropdown" id="profileMenu">
            <button class="profile-btn" data-dropdown-toggle aria-expanded="false" aria-haspopup="menu" aria-label="Menu akun">
                <span class="avatar avatar-sm" data-text="profileInitials">AU</span>
                <span class="profile-meta">
                    <strong data-text="profileName">Admin Utama</strong>
                    <small>Super Admin</small>
                </span>
                <span class="material-icons profile-caret">expand_more</span>
            </button>
            <div class="menu menu-right" role="menu">
                <button class="menu-item" role="menuitem" data-action="open-profile">
                    <span class="material-icons">account_circle</span>Profil saya
                </button>
                <button class="menu-item" role="menuitem" data-action="nav" data-view="pengaturan">
                    <span class="material-icons">settings</span>Pengaturan toko
                </button>
                <button class="menu-item" role="menuitem" data-action="toggle-theme">
                    <span class="material-icons">contrast</span>Ganti tema
                </button>
                <div class="menu-sep"></div>
                <button class="menu-item danger" role="menuitem" data-action="logout">
                    <span class="material-icons">logout</span>Keluar
                </button>
            </div>
        </div>
    </div>
</header>

<style>
    .topbar {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 32px;
        position: sticky;
        top: 0;
        z-index: 60;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
    }

    .menu-btn {
        display: none;
    }

    .page-title {
        min-width: 0;
        margin-right: auto;
    }

    .page-title h1 {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.5px;
        line-height: 1.2;
    }

    .page-title p {
        font-size: 13px;
        color: var(--muted);
        margin-top: 2px;
    }

    .search {
        position: relative;
        width: min(340px, 34vw);
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding: 0 38px 0 40px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
        color: var(--ink);
        font: inherit;
        font-size: 14px;
    }

    .search-input::placeholder {
        color: var(--muted);
    }

    .search-input::-webkit-search-cancel-button {
        display: none;
    }

    .search-kbd {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        font: inherit;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1px 7px;
        pointer-events: none;
    }

    .search-results {
        width: 100%;
        min-width: 340px;
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .create-btn {
        height: 42px;
        padding: 0 16px;
    }

    .bell {
        position: relative;
        width: 42px;
        height: 42px;
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 12px;
    }

    .bell-dot {
        position: absolute;
        top: 8px;
        right: 9px;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 8px;
        background: var(--danger);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        display: grid;
        place-items: center;
        border: 2px solid var(--surface);
        box-sizing: content-box;
        line-height: 1;
    }

    .bell-dot[hidden] {
        display: none;
    }

    .profile-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 42px;
        padding: 0 10px 0 5px;
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 21px;
        color: var(--ink);
    }

    .profile-meta {
        text-align: left;
        line-height: 1.2;
    }

    .profile-meta strong {
        display: block;
        font-size: 13px;
        font-weight: 700;
    }

    .profile-meta small {
        font-size: 11px;
        color: var(--muted);
    }

    .profile-caret {
        color: var(--muted);
    }

    @media (max-width: 1100px) {
        .search {
            width: 42px;
        }

        .search-input {
            padding: 0;
            width: 42px;
            color: transparent;
            cursor: pointer;
        }

        .search-input::placeholder {
            color: transparent;
        }

        .search-input:focus::placeholder {
            color: var(--muted);
        }

        .search-kbd {
            display: none;
        }

        .search-input:focus {
            position: fixed;
            left: 12px;
            right: 12px;
            top: 62px;
            width: auto;
            padding: 0 14px 0 42px;
            color: var(--ink);
            z-index: 80;
            box-shadow: var(--shadow-lg);
        }

        .search-input:focus ~ .search-results {
            position: fixed;
            left: 12px;
            right: 12px;
            top: 112px;
            width: auto;
            min-width: 0;
        }

        .search-input:focus + .search-kbd {
            display: none;
        }
    }

    @media (max-width: 600px) {
        .topbar {
            gap: 6px;
            padding: 8px 12px;
        }

        .topbar-actions {
            gap: 6px;
        }

        .page-title {
            flex: 1;
            min-width: 0;
        }

        .page-title h1 {
            font-size: 16px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .search,
        .search-input,
        .create-btn,
        .bell,
        .profile-btn {
            width: 38px;
            height: 38px;
        }

        .search-input:focus {
            top: 56px;
            height: 44px;
            width: auto;
        }

        .search-input:focus ~ .search-results {
            top: 106px;
        }

        .bell-dot {
            top: 4px;
            right: 4px;
        }
    }

    @media (max-width: 900px) {
        .topbar {
            padding: 10px 16px;
            gap: 10px;
        }

        .menu-btn {
            display: inline-grid;
        }

        .page-title h1 {
            font-size: 18px;
        }

        .page-title p {
            display: none;
        }

        .profile-meta,
        .profile-caret,
        .create-label {
            display: none;
        }

        .profile-btn {
            padding: 0 5px;
        }

        .create-btn {
            width: 42px;
            padding: 0;
        }
    }
</style>
