---
// Demo Katalog dan Chat entah kenapa butuh sekalii is:global

import "@langsungonline/ui/styles/global.css";
import "aos/dist/aos.css";
import FloatingBar from "./_FloatingBar.astro";
import DemoBar from "./_DemoBar.astro";

interface Props {
    title: string;
    description: string;
    image?: string;
    canonical?: string;
    // Opsional: tampilkan bar "Contoh website ... dibuat oleh Langsung.Online" di puncak halaman.
    bar?: { label: string; cta: string; bg: string; accent: string; message?: string };
}

const {
    title,
    description,
    image = "https://langsung.online/preview.jpeg",
    canonical = new URL(Astro.url.pathname, Astro.site).href,
    bar,
} = Astro.props;
---

<html lang="id">
    <head>
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-KV6Z7J0S96"
        ></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-KV6Z7J0S96");
        </script>
        
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{title} | Demo</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family:
                    system-ui,
                    -apple-system,
                    sans-serif;
                background: #f3f4f6;
                min-height: 100vh;
            }

            .demo-container {
                width: 100%;
                min-height: 100vh;
                background: white;
                container-type: inline-size;
                container-name: demo;
            }
        </style>

        <slot name="head" />
    </head>

    <body>
        <div class="demo-container">
            {bar && <DemoBar {...bar} />}
            <slot />
        </div>

        <FloatingBar title={title} />
    </body>
</html>
