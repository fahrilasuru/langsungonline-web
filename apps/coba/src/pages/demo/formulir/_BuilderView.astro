<!-- ===== PEMBUAT FORMULIR ===== -->
<section id="view-pembuat" class="view" role="tabpanel" aria-labelledby="tab-pembuat" hidden>
    <div class="view-inner">
        <div class="view-head">
            <div>
                <h2 class="view-title">Pembuat formulir</h2>
                <p id="bStats" class="view-sub"></p>
            </div>
            <div class="view-btns">
                <button type="button" id="btnResetForm" class="btn btn-ghost btn-sm">Kembalikan contoh</button>
                <button type="button" id="btnJson" class="btn btn-ghost btn-sm">Lihat JSON</button>
                <button type="button" id="btnPreview" class="btn btn-primary btn-sm">Pratinjau formulir</button>
            </div>
        </div>

        <div class="builder">
            <aside class="builder-side" aria-label="Tipe pertanyaan">
                <details id="palette" class="palette" open>
                    <summary>Tambah pertanyaan</summary>
                    <div id="paletteList"></div>
                </details>
                <p id="bActive" class="bs-active" role="status"></p>
            </aside>

            <div class="builder-main">
                <div class="side-card bform">
                    <div class="fld">
                        <label class="fld-label" for="bTitle">Judul formulir</label>
                        <input id="bTitle" class="inp" type="text" maxlength="80" autocomplete="off" />
                    </div>
                    <div class="fld">
                        <label class="fld-label" for="bDesc">Deskripsi</label>
                        <textarea id="bDesc" class="inp ta" rows="2" maxlength="240"></textarea>
                    </div>
                </div>

                <div id="builderCanvas"></div>

                <button type="button" id="btnAddSection" class="btn btn-ghost btn-block">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                    Tambah bagian
                </button>
            </div>
        </div>
    </div>
</section>
