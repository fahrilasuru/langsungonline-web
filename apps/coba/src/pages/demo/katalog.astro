---
import DemoWrapper from "./../../components/DemoWrapper.astro";
---

<DemoWrapper
    title="Katalog"
    description="Demo suatu laman katalog"
>
    <Fragment slot="head">
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
    </Fragment>

    <div class="body">
        <div class="bg-pattern"></div>

        <div class="floating-circle circle-1"></div>
        <div class="floating-circle circle-2"></div>
        <div class="floating-circle circle-3"></div>

        <main class="main-content">
            <div class="container">
                <header class="header">
                    <div class="header-left">
                        <div class="logo-wrapper">
                            <i class="fas fa-utensils logo-icon"></i>
                            <span class="logo-text">KACA RASA</span>
                        </div>
                    </div>

                    <div class="header-right">
                        <div class="status-badge">
                            <span class="status-dot"></span>
                            <span class="status-text">Buka • 10.00 - 22.00</span
                            >
                        </div>
                    </div>
                </header>

                <section class="hero">
                    <h1 class="hero-title">
                        Selamat Datang di
                        <span class="hero-highlight">Kaca Rasa</span>
                    </h1>
                    <p class="hero-subtitle">
                        Nikmati pengalaman kuliner kekinian dengan sentuhan
                        unik
                    </p>
                </section>

                <section class="filter-section">
                    <div class="search-container">
                        <div class="search-box">
                            <i class="fas fa-search search-icon"></i>
                            <input
                                type="text"
                                id="searchInput"
                                class="search-input"
                                placeholder="Cari menu favoritmu..."
                                autocomplete="off"
                            />
                        </div>

                        <div class="filter-actions">
                            <button class="btn-filter" id="filterToggle">
                                <i class="fas fa-sliders-h"></i>
                                <span>Filter</span>
                            </button>
                        </div>
                    </div>

                    <div class="categories-wrapper" id="categoriesWrapper">
                        <div class="categories-scroll">
                            <button
                                class="category-btn active"
                                data-category="all"
                            >
                                <span>Semua</span>
                                <span class="category-count">9</span>
                            </button>
                            <button
                                class="category-btn"
                                data-category="makanan"
                            >
                                <i class="fas fa-utensils"></i>
                                <span>Makanan</span>
                                <span class="category-count">4</span>
                            </button>
                            <button
                                class="category-btn"
                                data-category="minuman"
                            >
                                <i class="fas fa-wine-glass-alt"></i>
                                <span>Minuman</span>
                                <span class="category-count">3</span>
                            </button>
                            <button
                                class="category-btn"
                                data-category="dessert"
                            >
                                <i class="fas fa-cake"></i>
                                <span>Dessert</span>
                                <span class="category-count">2</span>
                            </button>
                        </div>
                    </div>
                </section>

                <section class="menu-section">
                    <div class="menu-grid" id="menuGrid"></div>
                </section>

                <section class="wa-section">
                    <div class="wa-card">
                        <div class="wa-content">
                            <i class="fab fa-whatsapp wa-icon"></i>
                            <div class="wa-text">
                                <h3>Pesan via WhatsApp</h3>
                                <p>
                                    Dapatkan free delivery untuk area tertentu
                                </p>
                            </div>
                        </div>
                        <a href="#" class="wa-button" id="waMainBtn">
                            <span>Chat Sekarang</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </section>
            </div>
        </main>

        <footer class="footer">
            <div class="container">
                <div class="footer-content">
                    <div class="footer-info">
                        <p>© 2025 Kaca Rasa. All rights reserved.</p>
                    </div>
                    <div class="footer-social">
                        <a href="#" aria-label="Instagram"
                            ><i class="fab fa-instagram"></i></a
                        >
                        <a href="#" aria-label="WhatsApp"
                            ><i class="fab fa-whatsapp"></i></a
                        >
                        <a href="#" aria-label="Email"
                            ><i class="far fa-envelope"></i></a
                        >
                    </div>
                </div>
            </div>
        </footer>
    </div>
</DemoWrapper>

<script>
    declare global {
    interface Window {
        addToCart: (itemId: number, itemName: string) => void;
        quickView: (itemId: number) => void;
    }
}
    (function () {
        // Define MenuItem interface
        interface MenuItem {
            id: number;
            name: string;
            category: string;
            subcategory: string;
            description: string;
            price: number;
            priceFormatted: string;
            image: string;
            isSpecial: boolean;
            rating: number;
            prepTime: string;
        }

        const MENU_ITEMS: MenuItem[] = [
            {
                id: 1,
                name: "RAMEN KACA",
                category: "makanan",
                subcategory: "signature",
                description:
                    "Kuah tonkotsu bening dengan chashu, jamur enoki, dan telur asin.",
                price: 49000,
                priceFormatted: "49K",
                image: "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?w=600&q=80",
                isSpecial: true,
                rating: 4.8,
                prepTime: "15-20 min",
            },
            {
                id: 2,
                name: "SASHIMI HIRU",
                category: "makanan",
                subcategory: "seafood",
                description:
                    "Ikan segar pilihan, disajikan dengan edamame & daikon.",
                price: 78000,
                priceFormatted: "78K",
                image: "https://images.unsplash.com/photo-1553621042-f6e147245754?w=600&q=80",
                isSpecial: true,
                rating: 4.9,
                prepTime: "10-15 min",
            },
            {
                id: 3,
                name: "AVOCADO TOAST",
                category: "makanan",
                subcategory: "breakfast",
                description:
                    "Roti sourdough, alpukat tumbuk, microgreens, dan poached egg.",
                price: 41000,
                priceFormatted: "41K",
                image: "https://images.unsplash.com/photo-1588137378633-dea1336ce1e2?w=600&q=80",
                isSpecial: false,
                rating: 4.5,
                prepTime: "10-12 min",
            },
            {
                id: 4,
                name: "PASTA AL LIMONE",
                category: "makanan",
                subcategory: "italian",
                description:
                    "Fettuccine dengan saus lemon, parmesan, dan daun peterseli.",
                price: 55000,
                priceFormatted: "55K",
                image: "https://images.unsplash.com/photo-1555949258-eb67b1ef0ceb?w=600&q=80",
                isSpecial: false,
                rating: 4.6,
                prepTime: "12-15 min",
            },
            {
                id: 5,
                name: "SPRITZ KABUT",
                category: "minuman",
                subcategory: "cocktail",
                description:
                    "Aperol, prosecco, dan soda dengan es serut transparan.",
                price: 65000,
                priceFormatted: "65K",
                image: "https://images.unsplash.com/photo-1551538827-9c037cb4f32a?w=600&q=80",
                isSpecial: true,
                rating: 4.8,
                prepTime: "5-7 min",
            },
            {
                id: 6,
                name: "KOPI GELAS",
                category: "minuman",
                subcategory: "coffee",
                description: "Cold brew 12 jam, disajikan dengan es batu kopi.",
                price: 28000,
                priceFormatted: "28K",
                image: "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?w=600&q=80",
                isSpecial: false,
                rating: 4.4,
                prepTime: "3-5 min",
            },
            {
                id: 7,
                name: "SUNSET MOCKTAIL",
                category: "minuman",
                subcategory: "mocktail",
                description:
                    "Jus markisa, soda, dan sirup delima dengan es batu.",
                price: 35000,
                priceFormatted: "35K",
                image: "https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?w=600&q=80",
                isSpecial: false,
                rating: 4.5,
                prepTime: "5-8 min",
            },
            {
                id: 8,
                name: "YUZU CHEESECAKE",
                category: "dessert",
                subcategory: "cake",
                description:
                    "Cream cheese lembut, curd yuzu segar, crust graham coklat.",
                price: 38000,
                priceFormatted: "38K",
                image: "https://images.unsplash.com/photo-1533134242443-d4fd215305ad?w=600&q=80",
                isSpecial: true,
                rating: 4.7,
                prepTime: "5 min",
            },
            {
                id: 9,
                name: "ES KRIM LAVENDER",
                category: "dessert",
                subcategory: "ice cream",
                description: "Dairy-free, madu lokal dan taburan bee pollen.",
                price: 27000,
                priceFormatted: "27K",
                image: "https://images.unsplash.com/photo-1501443762994-82bd5dace89a?w=600&q=80",
                isSpecial: false,
                rating: 4.7,
                prepTime: "3-5 min",
            },
        ];

        let currentCategory: string = "all";
        let currentSearch: string = "";
        let cartCount: number = 0;

        const menuGrid = document.getElementById("menuGrid") as HTMLElement | null;
        const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
        const categoryBtns = document.querySelectorAll(".category-btn") as NodeListOf<HTMLButtonElement>;
        const cartCountEl = document.querySelector(".cart-count") as HTMLElement | null;
        const waMainBtn = document.getElementById("waMainBtn") as HTMLAnchorElement | null;

        const formatRupiah = (price: number): string => {
            return new Intl.NumberFormat("id-ID", {
                style: "currency",
                currency: "IDR",
                minimumFractionDigits: 0,
                maximumFractionDigits: 0,
            }).format(price);
        };

        const renderRating = (rating: number): string => {
            const fullStars = Math.floor(rating);
            const hasHalf = rating % 1 >= 0.5;
            let stars = "";

            for (let i = 0; i < 5; i++) {
                if (i < fullStars) {
                    stars += '<i class="fas fa-star"></i>';
                } else if (i === fullStars && hasHalf) {
                    stars += '<i class="fas fa-star-half-alt"></i>';
                } else {
                    stars += '<i class="far fa-star"></i>';
                }
            }

            return `<div class="rating-stars">${stars} <span class="rating-value">${rating}</span></div>`;
        };

        const renderMenu = (items: MenuItem[]): void => {
            if (!menuGrid) return;

            if (items.length === 0) {
                menuGrid.innerHTML = `
                    <div class="no-results">
                        <i class="fas fa-search"></i>
                        <h3>Menu tidak ditemukan</h3>
                        <p>Coba kata kunci atau kategori lain</p>
                    </div>
                `;
                return;
            }

            menuGrid.innerHTML = items
                .map(
                    (item: MenuItem) => `
                <div class="menu-card" data-category="${item.category}">
                    ${item.isSpecial ? '<div class="card-badge">Special</div>' : ""}
                    
                    <div class="card-image">
                        <img src="${item.image}" alt="${item.name}" loading="lazy">
                        <div class="card-overlay">
                            <button class="btn-quickview" onclick="window.quickView(${item.id})">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="card-content">
                        <div class="card-header">
                            <span class="card-category">${item.subcategory}</span>
                            ${renderRating(item.rating)}
                        </div>
                        
                        <h3 class="card-title">${item.name}</h3>
                        <p class="card-description">${item.description}</p>
                        
                        <div class="card-meta">
                            <span class="prep-time">
                                <i class="far fa-clock"></i> ${item.prepTime}
                            </span>
                        </div>
                        
                        <div class="card-footer">
                            <span class="card-price">${formatRupiah(item.price)}</span>
                            <button class="btn-order" onclick="window.addToCart(${item.id}, '${item.name}')">
                                <i class="fas fa-plus"></i>
                                <span>Tambah</span>
                            </button>
                        </div>
                    </div>
                </div>
            `,
                )
                .join("");
        };

        const filterByCategory = (category: string): void => {
            currentCategory = category;

            categoryBtns.forEach((btn: HTMLButtonElement) => {
                const btnCategory = btn.dataset.category;
                btn.classList.toggle("active", btnCategory === category);
            });

            applyFilters();
        };

        const filterBySearch = (searchTerm: string): void => {
            currentSearch = searchTerm.toLowerCase().trim();
            applyFilters();
        };

        const applyFilters = (): void => {
            let filtered = [...MENU_ITEMS];

            if (currentCategory !== "all") {
                filtered = filtered.filter(
                    (item) => item.category === currentCategory,
                );
            }

            if (currentSearch) {
                filtered = filtered.filter(
                    (item) =>
                        item.name.toLowerCase().includes(currentSearch) ||
                        item.description
                            .toLowerCase()
                            .includes(currentSearch) ||
                        item.subcategory.toLowerCase().includes(currentSearch),
                );
            }

            renderMenu(filtered);
        };

        const updateCartCount = (): void => {
            if (cartCountEl) {
                cartCountEl.textContent = cartCount.toString();
                cartCountEl.style.display = cartCount > 0 ? "flex" : "none";
            }
        };

        // Declare global functions
        if (typeof window !== 'undefined') {
            window.addToCart = (itemId: number, itemName: string): void => {
                cartCount++;
                updateCartCount();

                const btn = (event?.currentTarget as HTMLElement);
                if (!btn) return;

                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i>';
                btn.style.background = "#10b981";

                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.style.background = "";
                }, 1000);
            };

            window.quickView = (itemId: number): void => {
                const item = MENU_ITEMS.find((i) => i.id === itemId);
                if (item) {
                    alert(
                        `Detail ${item.name}\nHarga: ${formatRupiah(item.price)}\nEstimasi: ${item.prepTime}`,
                    );
                }
            };
        }

        categoryBtns.forEach((btn: HTMLButtonElement) => {
            btn.addEventListener("click", () => {
                const category = btn.dataset.category;
                if (category) {
                    filterByCategory(category);
                }
            });
        });

        searchInput?.addEventListener("input", (e: Event) => {
            const target = e.target as HTMLInputElement;
            filterBySearch(target.value);
        });

        searchInput?.addEventListener("keyup", (e: KeyboardEvent) => {
            const target = e.target as HTMLInputElement;
            if (e.key === "Enter") {
                filterBySearch(target.value);
            }
        });

        const filterToggle = document.getElementById("filterToggle") as HTMLButtonElement | null;
        const categoriesWrapper = document.getElementById("categoriesWrapper") as HTMLElement | null;

        filterToggle?.addEventListener("click", () => {
            categoriesWrapper?.classList.toggle("show");
        });

        const updateCategoryCounts = (): void => {
            const counts: Record<string, number> = {
                all: MENU_ITEMS.length,
                makanan: MENU_ITEMS.filter(
                    (item) => item.category === "makanan",
                ).length,
                minuman: MENU_ITEMS.filter(
                    (item) => item.category === "minuman",
                ).length,
                dessert: MENU_ITEMS.filter(
                    (item) => item.category === "dessert",
                ).length,
            };

            categoryBtns.forEach((btn: HTMLButtonElement) => {
                const category = btn.dataset.category;
                const countEl = btn.querySelector(".category-count") as HTMLElement | null;
                if (countEl && category) {
                    countEl.textContent = counts[category]?.toString() || "0";
                }
            });
        };

        const init = (): void => {
            renderMenu(MENU_ITEMS);
            updateCategoryCounts();
            updateCartCount();
        };

        init();
    })();
</script>

<style is:global>
    .body {
        --primary: #1e1e2f;
        --secondary: #2d2d44;
        --accent: #c17b4b;
        --accent-light: #e89b6b;
        --bg-dark: #faf7f2;
        --bg-light: #ffffff;
        --text-dark: #1e1e2f;
        --text-light: #6b6b7a;
        --shadow-sm:
            0 4px 6px -1px rgba(0, 0, 0, 0.1),
            0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-md:
            0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --shadow-lg:
            0 20px 25px -5px rgba(0, 0, 0, 0.1),
            0 10px 10px -5px rgba(0, 0, 0, 0.04);
        --radius-sm: 8px;
        --radius-md: 16px;
        --radius-lg: 24px;
        --radius-xl: 32px;
        --transition: all 0.3s ease;

        font-family: "Plus Jakarta Sans", sans-serif;
        background: var(--bg-dark);
        color: var(--text-dark);
        line-height: 1.5;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }
    
    .body * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .bg-pattern {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image:
            radial-gradient(
                circle at 20% 20%,
                rgba(193, 123, 75, 0.03) 0%,
                transparent 50%
            ),
            radial-gradient(
                circle at 80% 70%,
                rgba(193, 123, 75, 0.03) 0%,
                transparent 50%
            );
        pointer-events: none;
        z-index: 0;
    }

    .floating-circle {
        position: fixed;
        border-radius: 50%;
        background: linear-gradient(
            135deg,
            rgba(193, 123, 75, 0.1),
            rgba(232, 155, 107, 0.05)
        );
        filter: blur(40px);
        animation: float 15s infinite ease-in-out;
        z-index: 0;
    }

    .circle-1 {
        width: 300px;
        height: 300px;
        top: -100px;
        right: -100px;
        animation-delay: 0s;
    }

    .circle-2 {
        width: 400px;
        height: 400px;
        bottom: -150px;
        left: -150px;
        animation-delay: -5s;
    }

    .circle-3 {
        width: 200px;
        height: 200px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation-delay: -2s;
    }

    @keyframes float {
        0%,
        100% {
            transform: translate(0, 0) scale(1);
        }
        33% {
            transform: translate(30px, -30px) scale(1.1);
        }
        66% {
            transform: translate(-20px, 20px) scale(0.9);
        }
    }

    .main-content {
        position: relative;
        z-index: 10;
        padding: 2rem 0;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: var(--radius-xl);
        padding: 1rem 2rem;
        margin-bottom: 3rem;
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .logo-wrapper {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .logo-icon {
        font-size: 1.5rem;
        color: var(--accent);
        background: linear-gradient(135deg, var(--accent-light), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .logo-text {
        font-size: 1.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
    }

    .status-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(16, 185, 129, 0.1);
        padding: 0.5rem 1.25rem;
        border-radius: var(--radius-xl);
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            transform: scale(1);
            opacity: 1;
        }
        50% {
            transform: scale(1.2);
            opacity: 0.7;
        }
    }

    .status-text {
        font-size: 0.875rem;
        font-weight: 600;
        color: #10b981;
    }

    .cart-icon {
        position: relative;
        color: var(--text-dark);
        font-size: 1.25rem;
        text-decoration: none;
        padding: 0.5rem;
        border-radius: 50%;
        background: white;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
    }

    .cart-icon:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        color: var(--accent);
    }

    .cart-count {
        position: absolute;
        top: -5px;
        right: -5px;
        background: var(--accent);
        color: white;
        font-size: 0.75rem;
        font-weight: 600;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero {
        text-align: center;
        margin-bottom: 3rem;
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1rem;
        color: var(--primary);
    }

    .hero-highlight {
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }

    .hero-subtitle {
        font-size: 1.125rem;
        color: var(--text-light);
        max-width: 600px;
        margin: 0 auto;
    }

    .filter-section {
        margin-bottom: 3rem;
    }

    .search-container {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .search-box {
        flex: 1;
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 1.25rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-light);
        font-size: 1rem;
    }

    .search-input {
        width: 100%;
        padding: 1rem 1rem 1rem 3rem;
        border: 2px solid transparent;
        border-radius: var(--radius-xl);
        background: white;
        font-size: 1rem;
        transition: var(--transition);
        box-shadow: var(--shadow-sm);
    }

    .search-input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: var(--shadow-md);
    }

    .btn-filter {
        padding: 1rem 2rem;
        background: white;
        border: none;
        border-radius: var(--radius-xl);
        color: var(--text-dark);
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: var(--transition);
        box-shadow: var(--shadow-sm);
    }

    .btn-filter:hover {
        background: var(--accent);
        color: white;
        transform: translateY(-2px);
