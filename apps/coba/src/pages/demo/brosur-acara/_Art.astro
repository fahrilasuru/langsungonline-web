---
// Ilustrasi inline (tanpa gambar eksternal). Ganti dengan <img> poster asli untuk klien sungguhan.
interface Props { name: "poster" | "map"; label?: string }
const { name, label = "" } = Astro.props;
---

{
    name === "poster" && (
        <svg class="art" viewBox="0 0 480 600" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
            <defs>
                <linearGradient id="po-bg" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#2e1065" />
                    <stop offset="1" stop-color="#6d28d9" />
                </linearGradient>
            </defs>
            <rect width="480" height="600" fill="url(#po-bg)" />
            <circle cx="400" cy="90" r="150" fill="#7c3aed" opacity=".55" />
            <circle cx="400" cy="90" r="96" fill="#a78bfa" opacity=".35" />
            <circle cx="400" cy="90" r="46" fill="#f59e0b" />
            <path d="M0 430c70-60 140-80 220-60s150 60 260 10v220H0z" fill="#1e1b3a" opacity=".55" />
            <g fill="none" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" opacity=".9">
                <path d="M70 330V250a50 50 0 0 1 100 0v80" />
                <path d="M190 330V220a50 50 0 0 1 100 0v110" />
                <path d="M310 330V260a50 50 0 0 1 100 0v70" />
            </g>
            <path d="M40 330h400" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" />
            <g fill="#fff">
                <text x="40" y="440" font-size="64" font-weight="800" letter-spacing="-2">NAIK</text>
                <text x="40" y="508" font-size="64" font-weight="800" letter-spacing="-2">KELAS</text>
            </g>
            <text x="42" y="548" font-size="16" font-weight="600" fill="#ddd6fe" letter-spacing="2">SEMINAR USAHA KULINER LOKAL</text>
        </svg>
    )
}

{
    name === "map" && (
        <svg class="art" viewBox="0 0 600 440" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
            <rect width="600" height="440" fill="#eeeaf7" />
            <rect x="40" y="40" width="130" height="100" rx="14" fill="#cfe5cf" />
            <rect x="440" y="250" width="120" height="110" rx="14" fill="#cfe5cf" />
            <g fill="#ddd6ee">
                <rect x="210" y="40" width="90" height="70" rx="6" />
                <rect x="330" y="40" width="80" height="70" rx="6" />
                <rect x="440" y="40" width="120" height="70" rx="6" />
                <rect x="40" y="190" width="110" height="80" rx="6" />
                <rect x="210" y="200" width="90" height="90" rx="6" />
                <rect x="330" y="210" width="80" height="80" rx="6" />
                <rect x="40" y="320" width="130" height="80" rx="6" />
                <rect x="210" y="330" width="200" height="70" rx="6" />
            </g>
            <g stroke="#fff" stroke-width="16" stroke-linecap="round" fill="none">
                <path d="M0 160h600" /><path d="M0 305h600" /><path d="M190 0v440" /><path d="M425 0v440" />
            </g>
            <g stroke="#cfc6e6" stroke-width="2" stroke-dasharray="10 10" fill="none"><path d="M0 160h600" /><path d="M190 0v440" /></g>
            <g font-size="13" font-weight="700" fill="#6b6591">
                <text x="60" y="152">Jl. Veteran</text>
                <text x="440" y="297">Jl. Kertoasri</text>
                <text x="178" y="90" transform="rotate(-90 178 90)">Jl. Soekarno-Hatta</text>
            </g>
            <circle class="pulse" cx="305" cy="160" r="26" fill="#6d28d9" opacity=".25" />
            <path d="M305 198s26-24 26-44a26 26 0 0 0-52 0c0 20 26 44 26 44z" fill="#6d28d9" stroke="#fff" stroke-width="3" />
            <circle cx="305" cy="154" r="9" fill="#fff" />
        </svg>
    )
}

<style>
    .art { display: block; width: 100%; height: 100%; }
    .pulse { transform-origin: 305px 160px; animation: pulse 2.6s ease-out infinite; }
    @keyframes pulse { from { transform: scale(0.6); opacity: 0.45; } to { transform: scale(1.6); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
