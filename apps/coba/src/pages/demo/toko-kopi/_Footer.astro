---
import { BASE, WA } from "./_products.js";
---
<footer class="ft">
  <div class="wrap">
    <div class="ft-g">
      <div>
        <a href={`${BASE}/`} class="brand"><span class="logo"><i class="fa-solid fa-mug-hot"></i></span>Teduh Coffee</a>
        <p style="max-width:300px">Kopi specialty Nusantara dan alat seduh pilihan, disangrai di Surabaya dan dikirim ke seluruh Indonesia.</p>
        <div class="soc">
          <a href={`https://wa.me/${WA}`} target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
          <a href="https://instagram.com/teduh.coffee" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          <a href="https://tiktok.com" target="_blank" rel="noopener" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
          <a href="mailto:halo@teduhcoffee.id" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
        </div>
      </div>
      <div><h4>Belanja</h4><a href={`${BASE}/produk?kat=biji`}>Biji Kopi</a><a href={`${BASE}/produk?kat=alat`}>Alat Seduh</a><a href={`${BASE}/produk?kat=paket`}>Paket Hemat</a><a href={`${BASE}/produk?kat=merch`}>Merchandise</a></div>
      <div><h4>Bantuan</h4><a href={`${BASE}/#faq`}>FAQ</a><a href={`${BASE}/keranjang`}>Keranjang</a><a href={`${BASE}/tentang#kontak`}>Hubungi kami</a><a href={`${BASE}/#langganan`}>Langganan</a></div>
      <div><h4>Pembayaran</h4><div class="pay"><i class="fa-solid fa-qrcode"></i><i class="fa-solid fa-building-columns"></i><i class="fa-solid fa-credit-card"></i><i class="fa-solid fa-money-bill-wave"></i></div><p style="margin-top:14px;font-size:13px">QRIS, transfer bank, virtual account dan COD.</p></div>
    </div>
    <div class="ft-b"><span>&copy; 2026 Teduh Coffee. Semua hak dilindungi.</span><span>Website demo oleh <a href="https://langsung.online" target="_blank" rel="noopener">Langsung.Online</a></span></div>
  </div>
</footer>
