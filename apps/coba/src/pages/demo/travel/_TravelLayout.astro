---
import DemoWrapper from "../_DemoWrapper.astro";
import { BASE, WA_DEFAULT, PHONE } from "./_data";

interface Props {
    title: string;
    description: string;
    active?: "beranda" | "paket" | "destinasi" | "tentang" | "kontak";
}
const { title, description, active = "beranda" } = Astro.props;

const nav = [
    { id: "beranda", label: "Beranda", href: `${BASE}/` },
    { id: "paket", label: "Paket Wisata", href: `${BASE}/paket/` },
    { id: "destinasi", label: "Destinasi", href: `${BASE}/destinasi/` },
    { id: "tentang", label: "Tentang", href: `${BASE}/tentang/` },
    { id: "kontak", label: "Kontak & FAQ", href: `${BASE}/kontak/` },
];

const schema = {
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    name: "Langkah Nusa Travel",
    description:
        "Biro perjalanan paket wisata domestik dan internasional, tiket, hotel, visa, dan custom itinerary.",
    address: {
        "@type": "PostalAddress",
        addressLocality: "Surabaya",
        addressRegion: "Jawa Timur",
        addressCountry: "ID",
    },
    telephone: `+${PHONE}`,
    priceRange: "Rp1.650.000 - Rp21.500.000",
    openingHours: "Mo-Sa 08:00-18:00",
    aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "4.9",
        reviewCount: "340",
    },
};
---

<DemoWrapper
    title={title}
    description={description}
    bar={{ label: "Contoh Website Biro Perjalanan", cta: "Mau bisnis Anda seperti ini?", bg: "#061d26", accent: "#f4a62a" }}
>
    <Fragment slot="head">
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
        />
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </Fragment>

    <div class="tv">
        <!-- HEADER -->
        <header class="tv-header" id="tvHeader">
            <div class="tv-header-inner">
                <a href={`${BASE}/`} class="tv-logo" aria-label="Langkah Nusa Travel - Beranda">
                    <span>Langkah Nusa</span>
                </a>

                <nav class="tv-nav" aria-label="Navigasi utama">
                    {nav.map((n) => (
                        <a href={n.href} class={n.id === active ? "is-active" : ""} aria-current={n.id === active ? "page" : undefined}>{n.label}</a>
                    ))}
                </nav>

                <div class="tv-header-actions">
                    <a href={WA_DEFAULT} class="btn btn-sun tv-header-cta" target="_blank" rel="noopener">
                        <i class="fa-brands fa-whatsapp"></i>
                        <span>Tanya Liburan</span>
                    </a>
                    <button class="tv-burger" id="tvBurger" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="tvMobile">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
            <nav class="tv-mobile" id="tvMobile" aria-label="Navigasi mobile">
                {nav.map((n) => <a href={n.href} class={n.id === active ? "is-active" : ""}>{n.label}</a>)}
                <a href={WA_DEFAULT} class="btn btn-sun" target="_blank" rel="noopener">
                    <i class="fa-brands fa-whatsapp"></i> Tanya Liburan
                </a>
            </nav>
        </header>

        <main id="main">
            <slot />
        </main>

        <!-- FOOTER -->
        <footer class="tv-footer">
            <div class="tv-wrap tv-footer-grid">
                <div>
                    <a href={`${BASE}/`} class="tv-logo tv-logo-light">
                        <span class="tv-logo-mark"><i class="fa-solid fa-compass"></i></span>
                        <span>Langkah Nusa</span>
                    </a>
                    <p class="tv-footer-about">
                        Biro perjalanan berbasis di Surabaya. Kami menyusun perjalanan domestik dan internasional untuk keluarga, pasangan, kantor, dan komunitas.
                    </p>
                    <div class="tv-social">
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                        <a href={WA_DEFAULT} aria-label="WhatsApp" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i></a>
                    </div>
                </div>
                <div>
                    <h3>Jelajahi</h3>
                    <ul>
                        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
                    </ul>
                </div>
                <div>
                    <h3>Paket Populer</h3>
                    <ul>
                        <li><a href={`${BASE}/paket/#bali-eksotis`}>Bali Eksotis</a></li>
                        <li><a href={`${BASE}/paket/#labuan-bajo-sailing`}>Labuan Bajo Sailing</a></li>
                        <li><a href={`${BASE}/paket/#bromo-ijen`}>Bromo – Ijen</a></li>
                        <li><a href={`${BASE}/paket/#jepang-sakura`}>Jepang Klasik</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Hubungi Kami</h3>
                    <ul class="tv-contact-list">
                        <li><i class="fa-solid fa-location-dot"></i> Jl. Contoh Raya No. 88, Surabaya</li>
                        <li><i class="fa-solid fa-phone"></i> +62 812-3456-7890</li>
                        <li><i class="fa-solid fa-envelope"></i> halo@langkahnusa.example</li>
                        <li><i class="fa-regular fa-clock"></i> Senin – Sabtu, 08.00 – 18.00</li>
                    </ul>
                </div>
            </div>
            <div class="tv-wrap tv-footer-bottom">
                <span>© 2026 Langkah Nusa Travel. Seluruh nama, harga, dan ulasan pada halaman ini adalah contoh.</span>
                <span>Website demo oleh <a href="https://langsung.online" target="_blank" rel="noopener">Langsung.Online</a></span>
            </div>
        </footer>

        <!-- FLOATING WA -->
        <a href={WA_DEFAULT} class="tv-float-wa" target="_blank" rel="noopener" aria-label="Chat WhatsApp">
            <i class="fa-brands fa-whatsapp"></i>
        </a>
    </div>

    <script>
        const burger = document.getElementById("tvBurger");
        const mobile = document.getElementById("tvMobile");
        burger?.addEventListener("click", () => {
            const open = mobile?.classList.toggle("is-open");
            burger.setAttribute("aria-expanded", String(!!open));
            burger.innerHTML = open
                ? '<i class="fa-solid fa-xmark"></i>'
                : '<i class="fa-solid fa-bars"></i>';
        });

        const header = document.getElementById("tvHeader");
        const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 10);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });

        // Reveal: hanya satu kali, untuk elemen bertanda data-reveal
        const items = document.querySelectorAll("[data-reveal]");
        if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const io = new IntersectionObserver(
                (entries) => entries.forEach((e) => {
                    if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
                }),
                { threshold: 0.12 },
            );
            items.forEach((el) => io.observe(el));
        } else {
            items.forEach((el) => el.classList.add("is-in"));
        }
    </script>
</DemoWrapper>

<style is:global>
    .tv {
        --ink: #0a2a36;
        --deep: #0d4657;
        --lagoon: #1b8ea3;
        --lagoon-dark: #146f80;
        --mist: #e9f4f5;
        --line: #d5e4e7;
        --sun: #f4a62a;
        --sun-dark: #dc8f12;
        --text: #1d3640;
        --muted: #50686f;
        --white: #fff;
        --radius: 14px;
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
        color: var(--text);
        background: #fff;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
    }
    .tv *, .tv *::before, .tv *::after { box-sizing: border-box; }
    .tv img { max-width: 100%; display: block; }
    .tv a { color: inherit; text-decoration: none; }
    .tv h1, .tv h2, .tv h3, .tv h4 {
        font-family: "Bricolage Grotesque", "Plus Jakarta Sans", sans-serif;
        color: var(--ink);
        line-height: 1.15;
        margin: 0;
        letter-spacing: -0.015em;
    }
    .tv p { margin: 0; }
    .tv ul { margin: 0; padding: 0; list-style: none; }
    .tv :focus-visible { outline: 3px solid var(--sun); outline-offset: 3px; border-radius: 6px; }

    .tv-wrap { max-width: 1160px; margin: 0 auto; padding: 0 24px; }

    /* buttons */
    .tv .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        padding: 14px 24px; border-radius: 999px; font-weight: 700; font-size: 15px;
        border: 2px solid transparent; cursor: pointer; transition: background .2s, transform .2s, color .2s, border-color .2s;
        font-family: inherit; line-height: 1.2;
    }
    .tv .btn-sun { background: var(--sun); color: #2b1b00; }
    .tv .btn-sun:hover { background: var(--sun-dark); transform: translateY(-2px); }
    .tv .btn-deep { background: var(--deep); color: #fff; }
    .tv .btn-deep:hover { background: var(--ink); transform: translateY(-2px); }
    .tv .btn-ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,.65); }
    .tv .btn-ghost:hover { background: rgba(255,255,255,.14); }
    .tv .btn-outline { background: transparent; color: var(--deep); border-color: var(--deep); }
    .tv .btn-outline:hover { background: var(--deep); color: #fff; }

    /* header */
    .tv-header {
        position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96);
        backdrop-filter: blur(10px); border-bottom: 1px solid transparent;
        transition: border-color .2s, box-shadow .2s;
    }
    .tv-header.is-scrolled { border-color: var(--line); box-shadow: 0 4px 18px rgba(10,42,54,.06); }
    .tv-header-inner { max-width: 1160px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .tv-logo { display: inline-flex; align-items: center; gap: 10px; font-family: "Bricolage Grotesque", sans-serif; font-weight: 800; font-size: 22px; color: var(--ink); letter-spacing: -0.02em; }
    .tv-logo-mark { width: 38px; height: 38px; border-radius: 12px; background: var(--deep); color: var(--sun); display: grid; place-items: center; font-size: 18px; }
    .tv-logo-light { color: #fff; }
    .tv-logo-light .tv-logo-mark { background: var(--sun); color: var(--ink); }
    .tv-nav { display: flex; gap: 28px; }
    .tv-nav a { font-weight: 600; font-size: 15px; color: var(--muted); padding: 6px 0; border-bottom: 2px solid transparent; transition: color .2s, border-color .2s; }
    .tv-nav a:hover, .tv-nav a.is-active { color: var(--ink); border-color: var(--sun); }
    .tv-header-actions { display: flex; align-items: center; gap: 12px; }
    .tv-header-cta { padding: 11px 20px; }
    .tv-burger { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line); background: #fff; color: var(--ink); font-size: 18px; cursor: pointer; }
    .tv-mobile { display: none; flex-direction: column; gap: 4px; padding: 8px 24px 20px; border-top: 1px solid var(--line); background: #fff; }
    .tv-mobile.is-open { display: flex; }
    .tv-mobile a:not(.btn) { padding: 12px 0; font-weight: 600; border-bottom: 1px solid var(--line); }
    .tv-mobile a.is-active { color: var(--lagoon-dark); }
    .tv-mobile .btn { margin-top: 12px; }

    /* sections */
    .tv-section { padding: 88px 0; }
    .tv-section.alt { background: var(--mist); }
    .tv-section.dark { background: var(--ink); color: #cfe3e8; }
    .tv-section.dark h2, .tv-section.dark h3 { color: #fff; }
    .tv-head { max-width: 680px; margin-bottom: 44px; }
    .tv-head.center { margin-left: auto; margin-right: auto; text-align: center; }
    .tv-head h2 { font-size: clamp(28px, 4vw, 42px); font-weight: 800; }
    .tv-head p { margin-top: 14px; font-size: 17px; color: var(--muted); }
    .dark .tv-head p { color: #a9c4cb; }

    /* page hero (subpages) */
    .tv-pagehero { position: relative; color: #fff; padding: 96px 0 80px; overflow: hidden; background: var(--deep); }
    .tv-pagehero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .tv-pagehero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(6,29,38,.9) 10%, rgba(6,29,38,.45)); }
    .tv-pagehero .tv-wrap { position: relative; z-index: 2; }
    .tv-pagehero h1 { color: #fff; font-size: clamp(34px, 5.5vw, 58px); font-weight: 800; max-width: 760px; }
    .tv-pagehero p { margin-top: 18px; max-width: 580px; font-size: 18px; color: #d6e9ee; }
    .tv-crumbs { font-size: 14px; color: #a9c4cb; margin-bottom: 20px; display: flex; gap: 8px; align-items: center; }
    .tv-crumbs a:hover { color: #fff; }

    /* package card */
    .tv-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
    .tv-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: box-shadow .25s, transform .25s; }
    .tv-card:hover { box-shadow: 0 18px 40px rgba(10,42,54,.12); transform: translateY(-4px); }
    .tv-card-img { position: relative; aspect-ratio: 4 / 3; background: var(--mist); overflow: hidden; }
    .tv-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
    .tv-card:hover .tv-card-img img { transform: scale(1.05); }
    .tv-badge { position: absolute; top: 14px; left: 14px; background: var(--sun); color: #2b1b00; font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 999px; }
    .tv-type { position: absolute; top: 14px; right: 14px; background: rgba(6,29,38,.78); color: #fff; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 999px; }
    .tv-card-body { padding: 22px; display: flex; flex-direction: column; flex: 1; gap: 12px; }
    .tv-meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13.5px; color: var(--muted); }
    .tv-meta i { color: var(--lagoon); margin-right: 6px; }
    .tv-card h3 { font-size: 20px; font-weight: 700; }
    .tv-card p { font-size: 14.5px; color: var(--muted); }
    .tv-card-foot { margin-top: auto; padding-top: 16px; border-top: 1px dashed var(--line); display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
    .tv-price small { display: block; font-size: 12px; color: var(--muted); }
    .tv-price strong { font-family: "Bricolage Grotesque", sans-serif; font-size: 22px; color: var(--deep); }
    .tv-rating { font-size: 13px; font-weight: 600; color: var(--ink); }
    .tv-rating i { color: var(--sun); }
    .tv-link { font-weight: 700; color: var(--lagoon-dark); font-size: 14.5px; display: inline-flex; gap: 8px; align-items: center; }
    .tv-link:hover { color: var(--ink); }

    /* footer */
    .tv-footer { background: #061d26; color: #a9c4cb; padding: 72px 0 0; font-size: 14.5px; }
    .tv-footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.3fr; gap: 40px; }
    .tv-footer h3 { color: #fff; font-size: 16px; margin-bottom: 16px; }
    .tv-footer li { margin-bottom: 10px; }
    .tv-footer a:hover { color: var(--sun); }
    .tv-footer-about { margin: 18px 0; max-width: 320px; }
    .tv-social { display: flex; gap: 10px; }
    .tv-social a { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,.08); display: grid; place-items: center; color: #fff; transition: background .2s; }
    .tv-social a:hover { background: var(--sun); color: var(--ink); }
    .tv-contact-list i { width: 22px; color: var(--sun); }
    .tv-footer-bottom { margin-top: 56px; padding-top: 24px; padding-bottom: 28px; border-top: 1px solid rgba(255,255,255,.1); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; }
    .tv-footer-bottom a { color: var(--sun); }

    .tv-float-wa { position: fixed; right: 20px; bottom: 20px; z-index: 60; width: 58px; height: 58px; border-radius: 50%; background: #25d366; color: #fff; font-size: 30px; display: grid; place-items: center; box-shadow: 0 10px 26px rgba(0,0,0,.28); transition: transform .2s; }
    .tv-float-wa:hover { transform: scale(1.08); }

    /* FAQ */
    .tv-faq { max-width: 820px; margin: 0 auto; display: grid; gap: 12px; }
    .tv-faq details { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 0 24px; }
    .tv-faq summary { cursor: pointer; padding: 20px 0; font-weight: 700; color: var(--ink); list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    .tv-faq summary::-webkit-details-marker { display: none; }
    .tv-faq summary::after { content: "\f067"; font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 13px; color: var(--lagoon); transition: transform .25s; }
    .tv-faq details[open] summary::after { transform: rotate(45deg); }
    .tv-faq details p { padding: 0 0 22px; color: var(--muted); }

    /* CTA band */
    .tv-cta { background: var(--deep); color: #fff; border-radius: 24px; padding: 56px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; position: relative; overflow: hidden; }
    .tv-cta h2 { color: #fff; font-size: clamp(26px, 3.5vw, 38px); font-weight: 800; }
    .tv-cta p { margin-top: 12px; color: #c4dde3; }
    .tv-cta-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }

    /* one-time reveal for key blocks */
    [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
    [data-reveal].is-in { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
        .tv * { transition: none !important; animation: none !important; }
        [data-reveal] { opacity: 1; transform: none; }
    }

    @media (max-width: 980px) {
        .tv-nav { display: none; }
        .tv-burger { display: inline-grid; place-items: center; }
        .tv-header-cta span { display: none; }
        .tv-header-cta { padding: 12px 14px; }
        .tv-grid-3 { grid-template-columns: repeat(2, 1fr); }
        .tv-footer-grid { grid-template-columns: 1fr 1fr; }
        .tv-cta { grid-template-columns: 1fr; padding: 40px 28px; }
        .tv-cta-actions { justify-content: flex-start; }
    }
    @media (max-width: 640px) {
        .tv-section { padding: 64px 0; }
        .tv-grid-3 { grid-template-columns: 1fr; }
        .tv-footer-grid { grid-template-columns: 1fr; }
        .tv-wrap { padding: 0 20px; }
    }
</style>
