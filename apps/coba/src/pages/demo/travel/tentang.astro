---
import TravelLayout from "./_TravelLayout.astro";
import { BASE, WA_DEFAULT, img } from "./_data";

const nilai = [
    { ikon: "fa-scale-balanced", judul: "Jujur soal biaya", isi: "Rincian termasuk dan tidak termasuk ditulis sebelum Anda membayar DP." },
    { ikon: "fa-hourglass-half", judul: "Jadwal yang manusiawi", isi: "Kami menghitung waktu tempuh dan istirahat, terutama untuk keluarga dan lansia." },
    { ikon: "fa-hand-holding-heart", judul: "Responsif", isi: "Pertanyaan di WhatsApp kami jawab pada jam kerja, dan ada kontak darurat selama trip." },
    { ikon: "fa-leaf", judul: "Wisata bertanggung jawab", isi: "Bekerja sama dengan pemandu dan homestay lokal, serta menjaga kebersihan lokasi wisata." },
];

const tim = [
    { nama: "Budi Santoso", peran: "Founder & Trip Designer", foto: "1560250097-0b93528c311a" },
    { nama: "Sari Wulandari", peran: "Operations Manager", foto: "1573496359142-b8d87734a5a2" },
    { nama: "Dimas Prakoso", peran: "Senior Tour Leader", foto: "1472099645785-5658abf4ff4e" },
    { nama: "Nadia Putri", peran: "Visa & Ticketing", foto: "1438761681033-6461ffad8d80" },
];

const jejak = [
    { tahun: "2017", isi: "Berdiri di Surabaya dengan open trip pertama ke Bromo." },
    { tahun: "2019", isi: "Membuka rute Bali, Lombok, dan Labuan Bajo." },
    { tahun: "2022", isi: "Kembali melayani perjalanan luar negeri: Jepang, Korea, Singapura." },
    { tahun: "2024", isi: "Layanan gathering kantor dan study tour sekolah." },
    { tahun: "2026", isi: "Lebih dari 3.400 traveler dan 340 ulasan dengan rating 4,9." },
];
---

<TravelLayout
    title="Tentang Kami | Langkah Nusa Travel"
    description="Kenali Langkah Nusa Travel: biro perjalanan Surabaya sejak 2017 dengan tim tour leader berpengalaman dan komitmen pada harga transparan."
    active="tentang"
>
    <section class="tv-pagehero">
        <img src={img("1530521954074-e64f6810b32d", 1800)} alt="Sekelompok teman berjalan di jalur pegunungan" loading="eager" />
        <div class="tv-wrap">
            <div class="tv-crumbs"><a href={`${BASE}/`}>Beranda</a> <i class="fa-solid fa-chevron-right"></i> <span>Tentang</span></div>
            <h1>Kami mulai dari satu trip ke Bromo dan satu aturan: tidak ada biaya tersembunyi.</h1>
            <p>Sembilan tahun kemudian, aturan itu masih sama.</p>
        </div>
    </section>

    <section class="tv-section">
        <div class="tv-wrap ab-story">
            <div>
                <div class="tv-head">
                    <h2>Cerita singkat Langkah Nusa</h2>
                </div>
                <p class="ab-p">Langkah Nusa didirikan oleh Budi Santoso, mantan pemandu gunung yang sering mendengar keluhan yang sama dari teman-temannya: ingin liburan, tetapi lelah mengurus semuanya sendiri dan khawatir ditipu.</p>
                <p class="ab-p">Dari situ kami membangun layanan yang sederhana. Itinerary ditulis jelas, harga tidak berubah-ubah, dan setiap rombongan didampingi orang yang benar-benar mengenal lokasi.</p>
                <p class="ab-p">Hari ini tim kami berisi trip designer, petugas visa dan tiket, serta tour leader yang bekerja sama dengan mitra lokal di setiap tujuan.</p>
                <a href={WA_DEFAULT} class="btn btn-deep" target="_blank" rel="noopener" style="margin-top:12px;"><i class="fa-brands fa-whatsapp"></i> Ngobrol dengan tim kami</a>
            </div>
            <div class="ab-photos">
                <img src={img("1522202176988-66273c2fd55f", 800)} alt="Tim bekerja bersama di meja kantor" loading="lazy" width="800" height="600" />
                <img src={img("1436491865332-7a61a109cc05", 800)} alt="Sayap pesawat di atas awan" loading="lazy" width="800" height="600" />
            </div>
        </div>
    </section>

    <section class="tv-section alt">
        <div class="tv-wrap">
            <div class="tv-head">
                <h2>Prinsip kerja kami</h2>
            </div>
            <div class="ab-values">
                {nilai.map((n) => (
                    <div class="ab-value">
                        <i class={`fa-solid ${n.ikon}`}></i>
                        <h3>{n.judul}</h3>
                        <p>{n.isi}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="tv-section">
        <div class="tv-wrap">
            <div class="tv-head">
                <h2>Perjalanan kami</h2>
            </div>
            <ol class="ab-timeline">
                {jejak.map((j) => (
                    <li><span class="ab-year">{j.tahun}</span><p>{j.isi}</p></li>
                ))}
            </ol>
        </div>
    </section>

    <section class="tv-section alt">
        <div class="tv-wrap">
            <div class="tv-head">
                <h2>Orang-orang di balik perjalanan Anda</h2>
                <p>Nama dan foto adalah contoh untuk keperluan demo.</p>
            </div>
            <div class="ab-team">
                {tim.map((t) => (
                    <div class="ab-member">
                        <img src={img(t.foto, 500)} alt={`Foto ${t.nama}`} loading="lazy" width="500" height="500" />
                        <h3>{t.nama}</h3>
                        <span>{t.peran}</span>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="tv-section">
        <div class="tv-wrap">
            <div class="ab-legal">
                <div>
                    <h2>Legalitas dan perlindungan</h2>
                    <p>Berikan rasa aman sebelum Anda membayar. Cantumkan data resmi bisnis di bagian ini.</p>
                </div>
                <ul>
                    <li><i class="fa-solid fa-file-shield"></i> Izin usaha biro perjalanan wisata (contoh)</li>
                    <li><i class="fa-solid fa-building-columns"></i> Rekening pembayaran atas nama perusahaan</li>
                    <li><i class="fa-solid fa-umbrella"></i> Opsi asuransi perjalanan untuk semua peserta</li>
                    <li><i class="fa-solid fa-file-signature"></i> Invoice dan kontrak tertulis untuk setiap pemesanan</li>
                </ul>
            </div>
        </div>
    </section>

    <section class="tv-section" style="padding-top:0;">
        <div class="tv-wrap">
            <div class="tv-cta">
                <div>
                    <h2>Siap bercerita tentang liburan yang Anda inginkan?</h2>
                    <p>Konsultasi gratis, tanpa kewajiban memesan.</p>
                </div>
                <div class="tv-cta-actions">
                    <a href={WA_DEFAULT} class="btn btn-sun" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Chat WhatsApp</a>
                    <a href={`${BASE}/paket/`} class="btn btn-ghost">Lihat paket</a>
                </div>
            </div>
        </div>
    </section>
</TravelLayout>

<style is:global>
    .ab-story { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; }
    .ab-p { color: #50686f; font-size: 17px; margin-bottom: 18px; max-width: 560px; }
    .ab-photos { display: grid; gap: 18px; }
    .ab-photos img { width: 100%; border-radius: 20px; object-fit: cover; aspect-ratio: 16 / 10; }
    .ab-photos img:nth-child(2) { width: 78%; justify-self: end; margin-top: -48px; border: 6px solid #fff; }

    .ab-values { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
    .ab-value { background: #fff; border-radius: 18px; padding: 28px; border: 1px solid #d5e4e7; }
    .ab-value i { font-size: 24px; color: #1b8ea3; margin-bottom: 16px; }
    .ab-value h3 { font-size: 18px; margin-bottom: 8px; }
    .ab-value p { color: #50686f; font-size: 14.5px; }

    .ab-timeline { list-style: none; margin: 0; padding: 0 0 0 28px; border-left: 2px solid #b9d3d8; display: grid; gap: 26px; max-width: 720px; }
    .ab-timeline li { position: relative; display: grid; grid-template-columns: 90px 1fr; gap: 16px; align-items: baseline; }
    .ab-timeline li::before { content: ""; position: absolute; left: -37px; top: 10px; width: 14px; height: 14px; border-radius: 50%; background: #f4a62a; border: 3px solid #fff; box-shadow: 0 0 0 2px #f4a62a; }
    .ab-year { font-family: "Bricolage Grotesque", sans-serif; font-weight: 800; font-size: 24px; color: #0d4657; }
    .ab-timeline p { color: #1d3640; }

    .ab-team { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .ab-member img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 18px; margin-bottom: 14px; }
    .ab-member h3 { font-size: 18px; }
    .ab-member span { font-size: 14px; color: #50686f; }

    .ab-legal { display: grid; grid-template-columns: 1fr 1.2fr; gap: 56px; align-items: center; background: #e9f4f5; border-radius: 24px; padding: 48px; }
    .ab-legal h2 { font-size: 30px; font-weight: 800; margin-bottom: 12px; }
    .ab-legal p { color: #50686f; }
    .ab-legal ul { display: grid; gap: 12px; }
    .ab-legal li { background: #fff; border-radius: 12px; padding: 14px 18px; display: flex; gap: 14px; align-items: center; font-weight: 500; }
    .ab-legal li i { color: #1b8ea3; width: 20px; }

    @media (max-width: 980px) {
        .ab-story, .ab-legal { grid-template-columns: 1fr; gap: 36px; }
        .ab-values, .ab-team { grid-template-columns: repeat(2, 1fr); }
        .ab-legal { padding: 32px 24px; }
    }
    @media (max-width: 640px) {
        .ab-values, .ab-team { grid-template-columns: 1fr; }
        .ab-timeline li { grid-template-columns: 1fr; gap: 2px; }
    }
</style>
