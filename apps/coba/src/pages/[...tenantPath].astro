---
export const prerender = false;

import NotFound from "@langsungonline/ui/components/NotFound.astro";

const modules = import.meta.glob("../tenants/**/*.astro");

const segments = (Astro.params.tenantPath ?? "")
  .split("/")
  .filter(Boolean);

const [tenant, ...rest] = segments;
const pagePath = rest.join("/");

const candidates = tenant
  ? pagePath
    ? [
        `../tenants/${tenant}/${pagePath}.astro`,
        `../tenants/${tenant}/${pagePath}/index.astro`,
      ]
    : [`../tenants/${tenant}/index.astro`]
  : [];

const modulePath = candidates.find((path) => path in modules);
const load = modulePath ? modules[modulePath] : undefined;

if (!load) {
  Astro.response.status = 404;
}

const Page = load ? (await load()).default : null;
---

{Page ? <Page /> : <NotFound>}
