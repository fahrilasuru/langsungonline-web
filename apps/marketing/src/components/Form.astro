        margin-top: 1rem;
        font-size: 0.85rem;
        color: #6b7280;
    }

    .form-note i {
        color: #16a34a;
    }

    /* Toast styling */
    .toast-container {
        position: fixed;
        top: 2rem;
        right: 2rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
