        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .form-wrapper {
        max-width: 800px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #f3f4f6;
        border-radius: 2rem;
        padding: 2.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .form-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .form-header h2 {
        font-size: clamp(1.5rem, 5vw, 2rem);
        font-weight: 700;
        color: #111827;
        margin-bottom: 0.75rem;
