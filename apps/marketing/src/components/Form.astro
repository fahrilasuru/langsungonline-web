    }

    .required {
        color: #ef4444;
        margin-left: 2px;
    }

    .optional {
        color: #9ca3af;
        font-weight: normal;
        font-size: 0.8rem;
    }

    .form-group input {
        padding: 0.75rem 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        font-size: 0.95rem;
        font-family: inherit;
        transition: all 0.2s ease;
        background: #ffffff;
        width: 100%;
    }

    .form-group input:focus {
        outline: none;
        border-color: #16a34a;
        box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.1);
    }

