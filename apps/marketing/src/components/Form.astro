
<section class="contact-form-section">
    <div class="container">
        <div class="form-wrapper" data-aos="fade-up">
            <div class="form-header">
                <h2>
                    Atau Cek <span class="gradient-text">Bisnis Anda</span> di Sini
                </h2>
                <p>
                    Isi data singkat di bawah ini dan kami akan melakukan audit awal untuk membantu membereskan kehadiran digital Anda.
                </p>
            </div>

            <form class="contact-form" id="contactForm" novalidate>
                <!-- Honeypot anti-bot: jangan diisi -->
                <div class="hp-field" aria-hidden="true">
                    <label for="website">Jangan isi kolom ini</label>
                    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
                </div>
                <div class="form-grid">
                    <!-- Nama Bisnis -->
                    <div class="form-group">
                        <label for="businessName">
                            Nama Bisnis <span class="required">*</span>
                        </label>
                        <input
                            type="text"
                            id="businessName"
                            name="businessName"
                            placeholder="Contoh: Kopi Senja Nusantara"
                            required
                        />
                        <span class="error-message" id="businessNameError"></span>
                    </div>

                    <!-- Bidang Usaha -->
                    <div class="form-group">
                        <label for="businessField">
                            Bidang Usaha <span class="required">*</span>
                        </label>
                        <input
                            type="text"
                            id="businessField"
                            name="businessField"
                            placeholder="Contoh: Kuliner / Servis AC / Laundry"
                            required
                        />
                        <span class="error-message" id="businessFieldError"></span>
                    </div>

                    <!-- Kota -->
                    <div class="form-group">
                        <label for="city">
                            Kota <span class="required">*</span>
                        </label>
                        <input
                            type="text"
                            id="city"
                            name="city"
                            placeholder="Contoh: Surabaya"
                            required
                        />
                        <span class="error-message" id="cityError"></span>
                    </div>

                    <!-- Website / Instagram (opsional) -->
                    <div class="form-group">
                        <label for="socialRef">
                            Website / Instagram <span class="optional">(opsional)</span>
                        </label>
                        <input
                            type="text"
                            id="socialRef"
                            name="socialRef"
                            placeholder="Contoh: @kopisenja atau kopisenja.com"
                        />
                        <span class="error-message" id="socialRefError"></span>
                    </div>

                    <!-- Apa yang paling ingin dibereskan? (Radio Options) -->
                    <div class="form-group full-width">
                        <label class="group-label">
                            Apa yang paling ingin dibereskan? <span class="required">*</span>
                        </label>
                        
                        <div class="radio-options-grid">
                            <label class="radio-card">
                                <input type="radio" name="goal" value="Belum punya presence online" required />
                                <span class="radio-custom"></span>
                                <span class="radio-text">Belum punya presence online</span>
                            </label>

                            <label class="radio-card">
                                <input type="radio" name="goal" value="Sulit ditemukan" />
                                <span class="radio-custom"></span>
                                <span class="radio-text">Sulit ditemukan</span>
                            </label>

                            <label class="radio-card">
                                <input type="radio" name="goal" value="Ingin terlihat lebih profesional" />
                                <span class="radio-custom"></span>
                                <span class="radio-text">Ingin terlihat lebih profesional</span>
                            </label>

                            <label class="radio-card">
                                <input type="radio" name="goal" value="Ingin mendapat lebih banyak inquiry" />
                                <span class="radio-custom"></span>
                                <span class="radio-text">Ingin mendapat lebih banyak inquiry</span>
                            </label>

                            <label class="radio-card">
                                <input type="radio" name="goal" value="Yang sudah ada berantakan" />
                                <span class="radio-custom"></span>
                                <span class="radio-text">Yang sudah ada berantakan</span>
                            </label>

                            <label class="radio-card">
                                <input type="radio" name="goal" value="Saya tidak tahu — tolong cek" />
                                <span class="radio-custom"></span>
                                <span class="radio-text font-semibold">Saya tidak tahu — tolong cek</span>
                            </label>
                        </div>
                        <span class="error-message" id="goalError"></span>
                    </div>

                    <!-- Nomor WhatsApp -->
                    <div class="form-group full-width">
                        <label for="whatsapp">
                            Nomor WhatsApp <span class="required">*</span>
                        </label>
                        <input
                            type="tel"
                            id="whatsapp"
                            name="whatsapp"
                            placeholder="Contoh: 081234567890"
                            required
                        />
                        <span class="error-message" id="whatsappError"></span>
                    </div>

                    <!-- Tombol Aksi -->
                    <div class="form-group full-width">
                        <button type="submit" class="submit-btn" id="submitBtn">
                            <i class="fas fa-stethoscope"></i>
                            <span>Cek Bisnis Saya</span>
                            <div class="spinner" id="submitSpinner"></div>
                        </button>
                        <p class="form-note">
                            <i class="fas fa-shield-alt"></i>
                            Data Anda aman dan tidak akan disebarkan
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>
</section>

<script>
    import { WA_NUMBER } from "@langsungonline/ui/constants";
    import { wa } from "@langsungonline/ui/wa";

    const API_URL = (
        (import.meta.env.PUBLIC_API_URL as string | undefined) ?? ""
    ).replace(/\/$/, "");
    const submitEndpoint = `${API_URL}/contact`;

    const form = document.querySelector<HTMLFormElement>("#contactForm");
    const submitBtn =
        document.querySelector<HTMLButtonElement>("#submitBtn");

    if (form && submitBtn) {
        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const businessName =
                document.querySelector<HTMLInputElement>("#businessName");

            const businessField =
                document.querySelector<HTMLInputElement>("#businessField");

            const city =
                document.querySelector<HTMLInputElement>("#city");

            const socialRef =
                document.querySelector<HTMLInputElement>("#socialRef");

            const whatsapp =
                document.querySelector<HTMLInputElement>("#whatsapp");

            const selectedGoal =
                document.querySelector<HTMLInputElement>(
                    'input[name="goal"]:checked'
                );


            if (
                !businessName ||
                !businessField ||
                !city ||
                !socialRef ||
                !whatsapp
            ) {
                return;
            }

            document
                .querySelectorAll<HTMLElement>(".error-message")
                .forEach((element) => {
                    element.textContent = "";
                });

            let isValid = true;

            if (!businessName.value.trim()) {
                setError(
                    "businessNameError",
                    "Nama bisnis harus diisi"
                );

                isValid = false;
            }

            if (!businessField.value.trim()) {
                setError(
                    "businessFieldError",
                    "Bidang usaha harus diisi"
                );

                isValid = false;
            }

            if (!city.value.trim()) {
                setError(
                    "cityError",
                    "Kota harus diisi"
                );

                isValid = false;
            }

            if (!selectedGoal) {
                setError(
                    "goalError",
                    "Silakan pilih salah satu tujuan"
                );

                isValid = false;
            }

            if (!whatsapp.value.trim()) {
                setError(
                    "whatsappError",
                    "Nomor WhatsApp harus diisi"
                );

                isValid = false;
            }

            if (!isValid || !selectedGoal) {
                return;
            }

            const payload = {
                business_name: businessName.value.trim(),
                business_field: businessField.value.trim(),
                city: city.value.trim(),
                social_ref: socialRef.value.trim() || null,
                goal: selectedGoal.value,
                whatsapp: whatsapp.value.trim(),
                website:
                    (form.elements.namedItem("website") as HTMLInputElement | null)
                        ?.value ?? "",
            };

            if (!API_URL) {
                showToast("error", "Gagal", "Layanan belum bisa dihubungi. Silakan coba lagi nanti.");
                return;
            }

            setLoading(true);

            try {
                const response = await fetch(
                    submitEndpoint,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(payload),
                    }
                );

                const data = await response.json().catch(() => ({}));

                if (!response.ok) {
                    throw new Error(
                        typeof data.detail === "string"
                            ? data.detail
                            : "Gagal mengirim data"
                    );
                }

                showToast(
                    "success",
                    "Berhasil",
                    "Data bisnis berhasil dikirim"
                );

                const whatsappMessage = [
                    "Halo, saya ingin Cek Bisnis Saya:",
                    "",
                    `Nama: ${payload.business_name}`,
                    `Bidang: ${payload.business_field}`,
                    `Kota: ${payload.city}`,
                    `Ref: ${payload.social_ref || "-"}`,
                    `Ingin dibereskan: ${payload.goal}`,
                    `WhatsApp: ${payload.whatsapp}`,
                ].join("\n");

                const whatsappUrl =
                    wa(WA_NUMBER, whatsappMessage);

                form.reset();

                window.open(
                    whatsappUrl,
                    "_blank",
                    "noopener,noreferrer"
                );

            } catch (error) {
                console.error(error);

                showToast(
                    "error",
                    "Gagal",
                    error instanceof Error
                        ? error.message
                        : "Terjadi kesalahan"
                );

            } finally {
                setLoading(false);
            }
        });
    }

    function setError(
        elementId: string,
        message: string
    ) {
        const element = document.getElementById(elementId);

        if (element) {
            element.textContent = message;
        }
    }

    function setLoading(loading: boolean) {
        if (!submitBtn) return;

        submitBtn.disabled = loading;
        submitBtn.classList.toggle("loading", loading);
    }


    function showToast(
        type: "success" | "error",
        title: string,
        message: string
    ) {
        const container =
            document.getElementById("toastContainer");

        if (!container) return;

        const toast = document.createElement("div");

        toast.className = `toast ${type}`;

        const body = document.createElement("div");
        const titleEl = document.createElement("div");
        titleEl.className = "toast-title";
        titleEl.textContent = title;
        const messageEl = document.createElement("div");
        messageEl.className = "toast-message";
        messageEl.textContent = message;
        body.append(titleEl, messageEl);
        toast.appendChild(body);

        container.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 4000);
    }
</script>

<style>
