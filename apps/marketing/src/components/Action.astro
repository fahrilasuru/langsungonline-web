---
import { LINK_KONSULTASI } from '@langsungonline/ui/constants';

const checkItems = [
    { name: "Website", status: "success", icon: "fas fa-globe", label: "✓" },
    { name: "Google Business", status: "warning", icon: "fas fa-map-marker-alt", label: "△" },
    { name: "Instagram / Sosmed", status: "success", icon: "fab fa-instagram", label: "✓" },
    { name: "Marketplace", status: "neutral", icon: "fas fa-store", label: "?" },
    { name: "WhatsApp Flow", status: "warning", icon: "fab fa-whatsapp", label: "△" },
];
---

<section class="py-20 bg-white overflow-hidden">
    <div class="container mx-auto px-4">
        
        <!-- Header Section -->
        <div class="text-center max-w-2xl mx-auto mb-16" data-aos="fade-up">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 tracking-tight">
                Mulai dari mana pun.
            </h2>
            <p class="text-lg text-gray-600">
                Belum online atau ingin melihat potensinya? Pilih jalur yang paling pas untuk bisnis Anda saat ini.
            </p>
        </div>

        <!-- Main Grid Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto items-center">
            
            <!-- KIRI: Preview (Future / Visual Mockup) -->
            <div class="bg-gradient-to-br from-emerald-50 via-teal-50/30 to-blue-50/50 rounded-3xl p-8 border border-emerald-100/60 shadow-lg flex flex-col justify-between h-full" data-aos="fade-right" data-aos-delay="100">
                <div>
                    <span class="inline-block py-1 px-3 rounded-full bg-emerald-600 text-white text-xs font-bold uppercase tracking-wider mb-4 shadow-sm">
                        Preview = Future
                    </span>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3">
                        ✦ Buat Preview
                    </h3>
                    <p class="text-gray-600 text-base leading-relaxed mb-6">
                        Lihat gambaran website, Google, social media, marketplace, dan jalur pelanggan yang cocok untuk bisnis Anda.
                    </p>

                    <!-- Visual Generated Preview Mockup -->
                    <div class="bg-white rounded-2xl p-4 shadow-md border border-emerald-100 mb-6">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
                            <div class="flex items-center space-x-2">
                                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                                <div class="w-3 h-3 rounded-full bg-green-400"></div>
                            </div>
                            <span class="text-[11px] font-medium text-gray-400 bg-gray-50 px-2.5 py-1 rounded-md">preview-bisnis.id</span>
                        </div>
                        <div class="space-y-2.5">
                            <div class="h-4 bg-emerald-100 rounded-lg w-3/4"></div>
                            <div class="h-3 bg-gray-100 rounded-lg w-full"></div>
                            <div class="h-3 bg-gray-100 rounded-lg w-5/6"></div>
                            <div class="flex gap-2 pt-2">
                                <div class="h-8 bg-emerald-600 rounded-lg w-1/3"></div>
                                <div class="h-8 bg-gray-100 rounded-lg w-1/3"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <a
                        href={LINK_KONSULTASI}
                        class="inline-flex items-center text-emerald-700 font-bold hover:text-emerald-800 transition-colors group"
                    >
                        Buat Preview 
                        <span class="ml-2 transform group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>

            <!-- KANAN: Check (Present / Channel Status) -->
            <div class="bg-gradient-to-br from-blue-50 via-indigo-50/30 to-purple-50/50 rounded-3xl p-8 border border-blue-100/60 shadow-lg flex flex-col justify-between h-full" data-aos="fade-left" data-aos-delay="200">
                <div>
                    <span class="inline-block py-1 px-3 rounded-full bg-blue-600 text-white text-xs font-bold uppercase tracking-wider mb-4 shadow-sm">
                        Check = Present
                    </span>
                    <h3 class="text-2xl font-bold text-gray-900 mb-3">
                        Cek Bisnis Saya
                    </h3>
                    <p class="text-gray-600 text-base leading-relaxed mb-6">
                        Kami lihat apa yang sudah beres, apa yang perlu perhatian, dan mana yang layak diprioritaskan.
                    </p>

                    <!-- Visual Channel Status List -->
                    <div class="bg-white rounded-2xl p-4 shadow-md border border-blue-100 mb-6 space-y-3">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Status Saluran Saat Ini:</span>
                        {checkItems.map((item) => (
                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                                <div class="flex items-center space-x-3">
                                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-sm">
                                        <i class={item.icon}></i>
                                    </div>
                                    <span class="text-sm font-medium text-gray-800">{item.name}</span>
                                </div>
                                <span class={`text-xs font-bold px-2.5 py-1 rounded-md ${
                                    item.label === '✓' ? 'bg-emerald-100 text-emerald-700' :
                                    item.label === '△' ? 'bg-amber-100 text-amber-700' : 'bg-gray-200 text-gray-600'
                                }`}>
                                    {item.label} Status
                                </span>
                            </div>
                        ))}
                    </div>
                </div>

                <div>
                    <a
                        href={LINK_KONSULTASI}
                        class="inline-flex items-center text-blue-700 font-bold hover:text-blue-800 transition-colors group"
                    >
                        Cek Bisnis 
                        <span class="ml-2 transform group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>