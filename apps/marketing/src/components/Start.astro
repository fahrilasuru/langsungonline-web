---
import { LINK_KONSULTASI } from '@langsungonline/ui/constants';

const auditItems = [
    { name: "Instagram", status: "Sudah Beres", type: "success", icon: "fab fa-instagram" },
    { name: "WhatsApp", status: "Sudah Beres", type: "success", icon: "fab fa-whatsapp" },
    { name: "Google Business", status: "Perlu Dirapikan", type: "warning", icon: "fas fa-map-marker-alt" },
    { name: "Informasi Kontak", status: "Perlu Dirapikan", type: "warning", icon: "fas fa-address-book" },
    { name: "Domain", status: "Belum Ada", type: "danger", icon: "fas fa-globe" },
    { name: "Website", status: "Belum Ada", type: "danger", icon: "fas fa-laptop-code" },
    { name: "Tracking", status: "Belum Ada", type: "danger", icon: "fas fa-chart-line" },
];
---

<section class="py-16 md:py-24 bg-white overflow-hidden">
    <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            
            <!-- Kolom Teks / Penjelasan -->
            <div data-aos="fade-right">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 text-green-700 text-sm font-semibold mb-4 border border-green-200">
                    <i class="fas fa-check-circle"></i> Bisnis Anda sudah benar-benar beres online?
                </div>
                
                <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 mb-6 leading-tight">
                    Kirim nama bisnis Anda. Kami cek apa yang sudah bagus, apa yang masih kurang, dan apa yang sebaiknya dibereskan lebih dulu.
                </h2>

                <p class="text-base text-gray-600 mb-6 leading-relaxed">
                    Tidak perlu bingung mulai dari mana. Kami lakukan audit cepat untuk melihat apa aset digital Anda yang sudah berjalan, apa yang masih kurang, dan bagian mana yang mendesak untuk diperbaiki.
                </p>

                <!-- Box Prioritas -->
                <div class="bg-gray-50 rounded-2xl p-5 mb-8 border border-gray-100">
                    <h4 class="text-xs font-bold tracking-wider text-gray-400 uppercase mb-2">Prioritas Kerja Kami:</h4>
                    <p class="text-sm font-semibold text-gray-800 flex items-center flex-wrap gap-1.5">
                        <span class="text-green-700">Bereskan Google</span> 
                        <i class="fas fa-arrow-right text-xs text-gray-400"></i> 
                        <span class="text-blue-700">Buat pusat informasi bisnis</span> 
                        <i class="fas fa-arrow-right text-xs text-gray-400"></i> 
                        <span class="text-purple-700">Arahkan semuanya ke WhatsApp</span>
                    </p>
                </div>

                <!-- CTA -->
                <div>
                    <a
                        href={LINK_KONSULTASI}
                        class="inline-flex items-center justify-center bg-linear-to-r from-green-600 to-blue-600 text-white px-8 py-4 rounded-xl font-medium shadow-lg hover:shadow-xl transition-all hover:scale-[1.02]"
                    >
                        Cek Bisnis Saya Gratis <i class="fas fa-arrow-right ml-2"></i>
                    </a>
                </div>
            </div>

            <!-- Kolom Visual Audit Sungguhan (Tangible) -->
            <div data-aos="fade-left">
                <div class="relative mx-auto max-w-md lg:max-w-none">
                    <!-- Background Glow Accent -->
                    <div class="absolute -inset-2 bg-linear-to-r from-green-600 to-blue-600 rounded-3xl blur-xl opacity-20"></div>

                    <!-- Card Simulasi Laporan Audit -->
                    <div class="relative bg-white rounded-2xl shadow-2xl border border-gray-100 p-6 md:p-8">
                        <div class="flex items-center justify-between pb-4 mb-6 border-b border-gray-100">
                            <div>
                                <span class="text-xs text-gray-400 font-medium">Contoh Hasil Audit</span>
                                <h3 class="text-base font-bold text-gray-900">Kopi Senja Nusantara</h3>
                            </div>
                            <span class="text-xs font-semibold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md">
                                Perlu Perhatian
                            </span>
                        </div>

                        <!-- Daftar Item Audit (Tanpa Badge) -->
                        <div class="space-y-3">
                            {
                                auditItems.map((item) => (
                                    <div class="flex items-center justify-between p-3 rounded-xl bg-gray-50/70 border border-gray-100">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-xs text-gray-600">
                                                <i class={item.icon}></i>
                                            </div>
                                            <span class="text-sm font-medium text-gray-800">{item.name}</span>
                                        </div>

                                        <div class="text-xs font-medium">
                                            {item.type === 'success' && (
                                                <span class="text-green-600 flex items-center gap-1">
                                                    Sudah Beres <i class="fas fa-check"></i>
                                                </span>
                                            )}
                                            {item.type === 'warning' && (
                                                <span class="text-amber-600 flex items-center gap-1">
                                                    Perlu Dirapikan <i class="fas fa-exclamation"></i>
                                                </span>
                                            )}
                                            {item.type === 'danger' && (
                                                <span class="text-red-500 flex items-center gap-1">
                                                    Belum Ada <i class="fas fa-times"></i>
                                                </span>
                                            )}
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>