---
import { LINK_STARTER, COBA_URL } from '@langsungonline/ui/constants';

export interface Props {
    showButton?: boolean;
    compact?: boolean;
}

const { showButton = true, compact = false } = Astro.props;

const packageData = {
    name: "Paket Starter",
    price: "Rp 0",
    description:
        "Punya situs sederhana dulu, upgrade kapan saja. Cocok untuk yang baru memulai.",
    icon: "fa-gift",
    badge: "Watermark",
    features: [
        "Template dengan watermark",
        "Alamat website gratis",
        "Hosting gratis",
        "1 halaman utama",
        "Form kontak sederhana",
        "Upgrade kapan saja",
    ],
};

const ctaButton = {
    text: "Coba Sekarang",
    icon: "fa-rocket",
    href: LINK_STARTER,
};

const demoButton = {
    text: "Lihat Demo",
    icon: "fa-eye",
    href: `${COBA_URL}/demo/`
};

const mobileCta = {
    text: "Lihat Paket Lainnya",
    icon: "fa-arrow-right",
    href: "/layanan",
    subtitle: "Ada paket tanpa watermark dan fitur lebih lengkap",
};
---

<section class="bg-white py-8 md:py-12">
    <div class="max-w-257 mx-auto px-4 md:px-8">
        <div class="max-w-4xl mx-auto">
            <div
                class="bg-linear-to-r from-gray-50 to-white rounded-xl md:rounded-2xl p-4 md:p-8 border border-gray-200 shadow-sm"
            >
                <div
                    class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6"
                >
                    <div
                        class="w-16 h-16 md:w-20 md:h-20 rounded-xl md:rounded-2xl bg-linear-to-br from-gray-100 to-gray-200 flex items-center justify-center mx-auto md:mx-0"
                    >
                        <i
                            class={`fas ${packageData.icon} text-gray-600 text-2xl md:text-3xl`}
                        ></i>
                    </div>

                    <div class="flex-1 text-center md:text-left">
                        <div
                            class="flex items-center justify-center md:justify-start gap-2 mb-1"
                        >
                            <h3
                                class="text-xl md:text-3xl font-bold text-gray-900"
                            >
                                {packageData.name}
                            </h3>
                        </div>
                        <p
                            class="text-sm md:text-base text-gray-600 mb-2 md:mb-3"
                        >
                            {packageData.description}
                        </p>
                        <div
                            class="flex flex-wrap items-center justify-center md:justify-start gap-2 md:gap-4"
                        >
                            <span
                                class="text-xl md:text-2xl font-bold text-gray-900"
                                >{packageData.price}</span
                            >
                            {
                                showButton && (
                                    <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto mt-2 md:mt-0 md:ml-4">
                                        <a
                                            href={ctaButton.href}
                                            class="px-4 md:px-6 py-2 md:py-2.5 border-2 border-green-600 text-green-700 font-semibold rounded-lg md:rounded-xl hover:bg-green-50 transition-all inline-flex items-center justify-center gap-1 md:gap-2 text-sm"
                                        >
                                            <i class={`fas ${ctaButton.icon}`} />
                                            {ctaButton.text}
                                        </a>
                                        <a
                                            href={demoButton.href}
                                            class="px-4 md:px-6 py-2 md:py-2.5 border-2 border-blue-600 text-blue-700 font-semibold rounded-lg md:rounded-xl hover:bg-blue-50 transition-all inline-flex items-center justify-center gap-1 md:gap-2 text-sm"
                                        >
                                            <i class={`fas ${demoButton.icon}`} />
                                            {demoButton.text}
                                        </a>
                                    </div>
                                )
                            }
                        </div>
                    </div>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-3 gap-2 md:gap-3 mt-4 md:mt-6 pt-4 md:pt-6 border-t border-gray-200"
                >
                    {
                        packageData.features.map((feature) => (
                            <div class="flex items-start text-xs md:text-sm text-gray-600">
                                <i class="fas fa-check-circle text-gray-400 mr-1 md:mr-2 text-xs mt-0.5 shrink-0" />
                                <span>{feature}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="md:hidden text-center mt-6">
        <a
            href={mobileCta.href}
            class="inline-flex items-center justify-center gap-2 w-full max-w-xs mx-auto px-6 py-3 bg-linear-to-r from-green-600 to-blue-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all"
        >
            <span>{mobileCta.text}</span>
            <i class={`fas ${mobileCta.icon} text-sm`}></i>
        </a>
        <p class="text-xs text-gray-500 mt-2">{mobileCta.subtitle}</p>
    </div>
</section>