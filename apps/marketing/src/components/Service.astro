---
import { LINK_KONSULTASI } from '@langsungonline/ui/constants';

const outcomes = [
    {
        title: "Hadir",
        desc: "Website, profil bisnis, marketplace, dan fondasi yang diperlukan.",
        icon: "fas fa-store-alt",
        color: "from-emerald-500 to-teal-600",
        badge: "01"
    },
    {
        title: "Ditemukan",
        desc: "Google, Maps, SEO lokal, dan jalur discovery.",
        icon: "fas fa-search-location",
        color: "from-blue-500 to-indigo-600",
        badge: "02"
    },
    {
        title: "Dipercaya",
        desc: "Tampilan, portfolio, review, informasi dan identitas yang konsisten.",
        icon: "fas fa-shield-alt",
        color: "from-purple-500 to-pink-600",
        badge: "03"
    },
    {
        title: "Dihubungi",
        desc: "WhatsApp, inquiry, booking, katalog atau jalur pembelian.",
        icon: "fab fa-whatsapp",
        color: "from-green-500 to-emerald-600",
        badge: "04"
    }
];
---

<section class="py-20 bg-gradient-to-b from-white to-gray-50/50 overflow-hidden">
    <div class="container mx-auto px-4">
        
        <!-- Jembatan / Transisi dari Preview & Check -->
        <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 tracking-tight mb-6">
                Yang Kami Bereskan
            </h2>
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-4">
                Dapat gambaran itu mudah. <span class="font-semibold text-gray-900">Membereskannya yang penting.</span>
            </p>
            <p class="text-base text-gray-500 max-w-2xl mx-auto">
                Preview menunjukkan arahnya. Cek Bisnis menunjukkan yang masih kurang. Kalau Anda ingin lanjut, tim kami bisa mengerjakannya sampai siap digunakan.
            </p>
        </div>

        <!-- 4 Outcome Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto mb-12">
            {outcomes.map((item, index) => (
                <div 
                    class="bg-white rounded-2xl p-6 md:p-7 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col justify-between group relative overflow-hidden"
                    data-aos="fade-up"
                    data-aos-delay={100 + index * 100}
                >
                    <!-- Background Glow on Hover -->
                    <div class="absolute -right-12 -bottom-12 w-32 h-32 bg-gradient-to-br from-emerald-50 to-blue-50 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-500 -z-0"></div>

                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-6">
                            <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${item.color} text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform`}>
                                <i class={`${item.icon} text-xl`}></i>
                            </div>
                            <span class="text-xs font-mono font-bold text-gray-300 group-hover:text-emerald-600 transition-colors">
                                {item.badge}
                            </span>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            {item.title}
                        </h3>
                        <p class="text-sm text-gray-600 leading-relaxed">
                            {item.desc}
                        </p>
                    </div>
                </div>
            ))}
        </div>

        <!-- Tetap Beres (Maintenance & Pendampingan) -->
        <div class="max-w-4xl mx-auto bg-white rounded-2xl p-6 md:p-8 border border-gray-100 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6" data-aos="fade-up" data-aos-delay="500">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                    <i class="fas fa-sync-alt text-lg"></i>
                </div>
                <div>
                    <h4 class="font-bold text-gray-900 text-base md:text-lg mb-1">
                        Tetap Beres
                    </h4>
                    <p class="text-sm text-gray-600">
                        Perubahan, maintenance, dan pendampingan setelah semuanya berjalan.
                    </p>
                </div>
            </div>
            <a
                href={LINK_KONSULTASI}
                class="shrink-0 bg-gray-900 hover:bg-green-600 text-white font-medium px-5 py-2.5 rounded-xl text-sm transition-colors shadow-sm"
            >
                Konsultasikan Bisnis
            </a>
        </div>

    </div>
</section>