---
import TokoLayout from "../_TokoLayout.astro";
import ProductCard from "../_ProductCard.astro";
import { products, reviews, categories, fmt, BASE, WA } from "../_products.js";
export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const cat = categories.find((c) => c.id === p.cat);
const related = products.filter((x) => x.cat === p.cat && x.slug !== p.slug).concat(products.filter((x) => x.cat !== p.cat)).slice(0, 4);
const pct = p.old ? Math.round((1 - p.price / p.old) * 100) : 0;
---
<TokoLayout title={`${p.name} | Teduh Coffee`} description={p.short + " " + p.desc.slice(0, 100)} active="produk">
<section class="phero" style="padding:32px 0"><div class="wrap"><div class="crumb" style="margin:0"><a href={`${BASE}/`}>Beranda</a><i class="fa-solid fa-chevron-right"></i><a href={`${BASE}/produk?kat=${p.cat}`}>{cat.label}</a><i class="fa-solid fa-chevron-right"></i>{p.name}</div></div></section>

<section class="sec" style="padding:48px 0 64px" data-slug={p.slug} id="pdp">
  <div class="wrap pd">
    <div>
      <div class="gm" style={`background:${p.bg}`}><img id="gmain" src={p.imgs[0]} alt={p.name} onerror="this.style.display='none'" /></div>
      <div class="gt">{p.imgs.map((s, i) => <button class={i === 0 ? "on" : ""} data-img={s} aria-label={`Foto ${i + 1}`}><img src={s} alt="" onerror="this.style.display='none'" /></button>)}</div>
    </div>
    <div class="pi">
      <div class="pmeta"><i class="fa-solid fa-star"></i> {p.rating} ({p.reviews} ulasan) · {p.sold.toLocaleString("id-ID")} terjual</div>
      <h1>{p.name}</h1>
      <p class="mute">{p.short}</p>
      <div class="price"><span id="pr">{fmt(p.price)}</span>{p.old && <s id="po">{fmt(p.old)}</s>} {pct > 0 && <span class="tag" style="position:static;margin-left:8px">Hemat {pct}%</span>}</div>
      {p.notes.length > 0 && <div class="chips">{p.notes.map((n) => <span class="chip">{n}</span>)}</div>}
      {p.cat === "biji" && <div class="roast">Tingkat sangrai <span>{[1, 2, 3, 4, 5].map((n) => <i class={n <= p.roast ? "on" : ""}></i>)}</span></div>}
      <div><span class="lbl">Pilih varian</span><div class="vopts" id="vopts">{p.variants.map((v, i) => <button class={`opt ${i === 0 ? "on" : ""}`} data-v={i} data-extra={v.add}>{v.label}{v.add > 0 && ` (+${fmt(v.add)})`}</button>)}</div></div>
      <div class="buy">
        <div class="qty"><button id="dec" aria-label="Kurangi"><i class="fa-solid fa-minus"></i></button><span id="qv">1</span><button id="inc" aria-label="Tambah"><i class="fa-solid fa-plus"></i></button></div>
        <button class="btn ghost" id="buyNow">Beli sekarang</button>
      </div>
      <div class="stickybar"><button class="btn moss full" id="addBtn" data-add={p.slug}><i class="fa-solid fa-cart-plus"></i> Tambah ke keranjang</button></div>
      <div style="display:flex;gap:10px">
        <button class="btn ghost sm" data-wish={p.slug}><i class="fa-regular fa-heart"></i> Wishlist</button>
        <a class="btn ghost sm" target="_blank" rel="noopener" href={`https://wa.me/${WA}?text=${encodeURIComponent("Halo Teduh, saya ingin bertanya tentang " + p.name)}`}><i class="fa-brands fa-whatsapp"></i> Tanya admin</a>
      </div>
      <div class="assure"><span><i class="fa-solid fa-truck-fast"></i>Dikirim 1-2 hari</span><span><i class="fa-solid fa-rotate-left"></i>Garansi tukar 7 hari</span><span><i class="fa-solid fa-shield-halved"></i>Pembayaran aman</span><span><i class="fa-solid fa-box"></i>Kemasan rapi</span></div>
    </div>
  </div>
</section>

<section class="sec alt" style="padding:56px 0">
  <div class="wrap">
    <div class="tabs" role="tablist"><button class="on" data-t="t1">Deskripsi</button><button data-t="t2">Spesifikasi</button><button data-t="t3">Ulasan ({p.reviews})</button><button data-t="t4">Pengiriman</button></div>
    <div class="tp on" id="t1"><p style="max-width:700px">{p.desc}</p></div>
    <div class="tp" id="t2"><table class="spec">{p.specs.map(([a, b]) => <tr><td>{a}</td><td><b>{b}</b></td></tr>)}</table></div>
    <div class="tp" id="t3"><div class="rev">{reviews.map((r) => <div><div class="st">{"★".repeat(r.stars)}{"☆".repeat(5 - r.stars)}</div><b>{r.name}</b> <span class="mute">· {r.city}</span><p>{r.text}</p></div>)}<p class="note" style="text-align:left">*Ulasan demo/fiktif.</p></div></div>
    <div class="tp" id="t4"><p style="max-width:700px">Pesanan sebelum pukul 14.00 diproses di hari yang sama. Surabaya bisa same day, kota lain 1-3 hari kerja. Gratis ongkir untuk belanja mulai Rp250.000.</p></div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="lead"><div class="sh"><h2>Mungkin Anda suka</h2></div></div>
    <div class="pgrid">{related.map((r) => <ProductCard p={r} />)}</div>
  </div>
</section>
</TokoLayout>

<script>
  import { Cart, fmt } from "../_cart.js";
  const $ = (s) => document.querySelector(s), root = $("#pdp"), slug = root.dataset.slug;
  const base = $(".toko").dataset.base;
  let v = 0, q = 1;
  const addBtn = $("#addBtn");
  // jumlah dan varian dibaca oleh handler global lewat data-attribute
  const sync = () => { addBtn.dataset.v = v; addBtn.dataset.qty = q; $("#qv").textContent = q; };
  $("#inc").onclick = () => { q++; sync(); }; $("#dec").onclick = () => { q = Math.max(1, q - 1); sync(); };
  const basePrice = parseInt($("#pr").textContent.replace(/\D/g, ""));
  const oldEl = $("#po"), oldBase = oldEl ? parseInt(oldEl.textContent.replace(/\D/g, "")) : 0;
  $("#vopts").addEventListener("click", (e) => {
    const b = e.target.closest("[data-v]"); if (!b) return;
    v = +b.dataset.v; document.querySelectorAll("#vopts .opt").forEach((x) => x.classList.toggle("on", x === b));
    $("#pr").textContent = fmt(basePrice + +b.dataset.extra); if (oldEl) oldEl.textContent = fmt(oldBase + +b.dataset.extra); sync();
  });
  $("#buyNow").onclick = () => { Cart.add(slug, v, q); location.href = base + "/checkout"; };
  document.querySelectorAll(".gt button").forEach((b) => b.addEventListener("click", () => {
    $("#gmain").src = b.dataset.img; $("#gmain").style.display = ""; document.querySelectorAll(".gt button").forEach((x) => x.classList.toggle("on", x === b));
  }));
  document.querySelectorAll(".tabs button").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll(".tabs button").forEach((x) => x.classList.toggle("on", x === b));
    document.querySelectorAll(".tp").forEach((t) => t.classList.toggle("on", t.id === b.dataset.t));
  }));
  sync();
</script>
