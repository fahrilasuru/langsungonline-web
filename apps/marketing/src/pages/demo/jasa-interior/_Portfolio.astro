    }

    .portfolio-img {
        height: 240px;
        overflow: hidden;
        position: relative;
    }

    .portfolio-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

