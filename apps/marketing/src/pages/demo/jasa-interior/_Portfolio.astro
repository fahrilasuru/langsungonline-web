<!-- Portfolio Modal -->
<div
    class="modal-overlay"
    id="portfolioModal"
    role="dialog"
    aria-modal="true"
    aria-label="Detail proyek"
>
    <div class="modal-wrapper">
        <button
            class="modal-close"
            id="modalClose"
            aria-label="Tutup detail proyek"
        >
            <svg viewBox="0 0 24 24"
                ><line x1="18" y1="6" x2="6" y2="18"></line><line
                    x1="6"
                    y1="6"
                    x2="18"
                    y2="18"></line></svg
            >
        </button>
        <div class="modal">
            <div class="modal-img">
                <img src="" alt="" id="modalImg" loading="lazy" />
            </div>
            <div class="modal-body">
                <h3 id="modalTitle"></h3>
                <div class="modal-meta">
                    <span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"
                            ><path
                                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                            ></path></svg
                        >
                        <span id="modalLocation"></span>
                    </span>
                    <span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"
                            ><rect
                                x="3"
                                y="3"
                                width="18"
                                height="18"
                                rx="2"
                                ry="2"></rect><line
                                x1="3"
                                y1="9"
                                x2="21"
                                y2="9"></line><line
                                x1="9"
                                y1="21"
                                x2="9"
                                y2="9"></line></svg
                        >
                        <span id="modalType"></span>
                    </span>
                </div>
                <div class="modal-section">
                    <h4>Kebutuhan Klien</h4>
                    <p id="modalNeed"></p>
                </div>
                <div class="modal-section">
                    <h4>Solusi</h4>
                    <p id="modalSolution"></p>
                </div>
                <div class="modal-section">
                    <h4>Scope Pekerjaan</h4>
                    <p id="modalScope"></p>
                </div>
            </div>
        </div>
