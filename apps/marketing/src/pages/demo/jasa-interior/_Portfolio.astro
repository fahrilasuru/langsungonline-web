        width: 14px;
        height: 14px;
        fill: var(--accent);
        flex-shrink: 0;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(31, 42, 54, 0.8);
        backdrop-filter: blur(8px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
